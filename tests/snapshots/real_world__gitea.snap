      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Check for new Gitea versions"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[cron.update_checker]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RUN_AT_START = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_SUCCESS_NOTICE = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SCHEDULE = @every 168h"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";HTTP_ENDPOINT = https://dl.gitea.com/gitea/version.json"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Delete all old system notices from database"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[cron.delete_old_system_notices]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RUN_AT_START = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";NO_SUCCESS_NOTICE = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SCHEDULE = @every 168h"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";OLDER_THAN = 8760h"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Garbage collect LFS pointers in repositories"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[cron.gc_lfs]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Garbage collect LFS pointers in repositories (default false)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RUN_AT_START = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Interval as a duration between each gc run (default every 24h)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SCHEDULE = @every 24h"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Only attempt to garbage collect LFSMetaObjects older than this (default 7 days)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";OLDER_THAN = 168h"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Only attempt to garbage collect LFSMetaObjects that have not been attempted to be garbage collected for this long (default 3 days)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LAST_UPDATED_MORE_THAN_AGO = 72h"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT "; Minimum number of stale LFSMetaObjects to check per repo. Set to `0` to always check all."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";NUMBER_TO_CHECK_PER_REPO = 100"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";Check at least this proportion of LFSMetaObjects per repo. (This may cause all stale LFSMetaObjects to be checked.)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PROPORTION_TO_CHECK_PER_REPO = 0.6"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Rebuild issue index"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[cron.rebuild_issue_indexer]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RUN_AT_START = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";NO_SUCCESS_NOTICE = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SCHEDULE = @annually"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Actions cron tasks"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Stop running tasks which haven't been updated for a long time"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[cron.stop_zombie_tasks]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RUN_AT_START = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";NO_SUCCESS_NOTICE = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SCHEDULE = @every 5m"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Stop running tasks which have running status and continuous updates but don't end for a long time"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[cron.stop_endless_tasks]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RUN_AT_START = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";NO_SUCCESS_NOTICE = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SCHEDULE = @every 30m"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Cancel jobs which haven't been picked up for a long time"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[cron.cancel_abandoned_jobs]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RUN_AT_START = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";NO_SUCCESS_NOTICE = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SCHEDULE = @every 6h"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Start cron based actions"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[cron.start_schedule_tasks]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RUN_AT_START = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";NO_SUCCESS_NOTICE = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SCHEDULE = @every 1m"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[mirror]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enables the mirror functionality. Set to **false** to disable all mirrors. Pre-existing mirrors remain valid but won't be updated; may be converted to regular repo."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Disable the creation of **new** pull mirrors. Pre-existing mirrors remain valid. Will be ignored if `mirror.ENABLED` is `false`."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DISABLE_NEW_PULL = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Disable the creation of **new** push mirrors. Pre-existing mirrors remain valid. Will be ignored if `mirror.ENABLED` is `false`."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DISABLE_NEW_PUSH = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default interval as a duration between each check"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_INTERVAL = 8h"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Min interval as a duration must be > 1m"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MIN_INTERVAL = 10m"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[api]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enables the API documentation endpoints (/api/swagger, /api/v1/swagger, …). True or false."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_SWAGGER = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Max number of items in a page"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MAX_RESPONSE_ITEMS = 50"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default paging number of api"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_PAGING_NUM = 30"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default and maximum number of items per page for git trees api"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_GIT_TREES_PER_PAGE = 1000"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default max size of a blob returned by the blobs API (default is 10MiB)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_MAX_BLOB_SIZE = 10485760"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default max combined size of all blobs returned by the files API (default is 100MiB)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_MAX_RESPONSE_SIZE = 104857600"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[i18n]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The first locale will be used as the default if user browser's language doesn't match any locale in the list."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LANGS = en-US,zh-CN,zh-HK,zh-TW,de-DE,fr-FR,nl-NL,lv-LV,ru-RU,uk-UA,ja-JP,es-ES,pt-BR,pt-PT,pl-PL,bg-BG,it-IT,fi-FI,tr-TR,cs-CZ,sv-SE,ko-KR,el-GR,fa-IR,hu-HU,id-ID,ml-IN"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";NAMES = English,简体中文,繁體中文（香港）,繁體中文（台灣）,Deutsch,Français,Nederlands,Latviešu,Русский,Українська,日本語,Español,Português do Brasil,Português de Portugal,Polski,Български,Italiano,Suomi,Türkçe,Čeština,Српски,Svenska,한국어,Ελληνικά,فارسی,Magyar nyelv,Bahasa Indonesia,മലയ\u{d3e}ളം"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[highlight.mapping]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Extension mapping to highlight class, for example:"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; .toml = ini"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; .my-js = JavaScript"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[other]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Show version information about Gitea and Go in the footer"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SHOW_FOOTER_VERSION = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Show template execution time in the footer"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SHOW_FOOTER_TEMPLATE_LOAD_TIME = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Show the \"powered by\" text in the footer"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SHOW_FOOTER_POWERED_BY = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Generate sitemap. Defaults to `true`."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_SITEMAP = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enable/Disable RSS/Atom feed"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_FEED = true"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[markup]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Set the maximum number of characters in a mermaid source. (Set to -1 to disable limits)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MERMAID_MAX_SOURCE_CHARACTERS = 50000"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[markup.sanitizer.1]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The following keys can appear once to define a sanitation policy rule."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; This section can appear multiple times by adding a unique alphanumeric suffix to define multiple rules."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; e.g., [markup.sanitizer.1] -> [markup.sanitizer.2] -> [markup.sanitizer.TeX]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ELEMENT = span"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ALLOW_ATTR = class"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REGEXP = ^(info|warning|error)$"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Other markup formats e.g. asciidoc"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; uncomment and enable the below section."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; (You can add other markup formats by copying the section and adjusting"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;  the section name suffix \"asciidoc\" to something else.)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[markup.asciidoc]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; List of file extensions that should be rendered by an external command"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";FILE_EXTENSIONS = .adoc,.asciidoc"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; External command to render all matching extensions"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RENDER_COMMAND = \"asciidoc --out-file=- -\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Don't pass the file on STDIN, pass the filename as argument instead."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";IS_INPUT_FILE = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; How the content will be rendered."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; * sanitized: Sanitize the content and render it inside current page, default to only allow a few HTML tags and attributes. Customized sanitizer rules can be defined in [markup.sanitizer.*] ."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; * no-sanitizer: Disable the sanitizer and render the content inside current page. It's **insecure** and may lead to XSS attack if the content contains malicious code."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; * iframe: Render the content in a separate standalone page and embed it into current page by iframe. The iframe is in sandbox mode with same-origin disabled, and the JS code are safely isolated from parent page."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RENDER_CONTENT_MODE = sanitized"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The sandbox applied to the iframe and Content-Security-Policy header when RENDER_CONTENT_MODE is `iframe`."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; It defaults to a safe set of \"allow-*\" restrictions (space separated)."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; You can also set it by your requirements or use \"disabled\" to disable the sandbox completely."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; When set it, make sure there is no security risk:"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; * PDF-only content: generally safe to use \"disabled\", and it needs to be \"disabled\" because PDF only renders with no sandbox."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; * HTML content with JS: if the \"RENDER_COMMAND\" can guarantee there is no XSS, then it is safe, otherwise, you need to fine tune the \"allow-*\" restrictions."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RENDER_CONTENT_SANDBOX ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Whether post-process the rendered HTML content, including:"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; resolve relative links and image sources, recognizing issue/commit references, escaping invisible characters,"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; mentioning users, rendering permlink code blocks, replacing emoji shorthands, etc."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; By default, this is true when RENDER_CONTENT_MODE is `sanitized`, otherwise false."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";NEED_POST_PROCESS = false"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[metrics]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enables metrics endpoint. True or false; default is false."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If you want to add authorization, specify a token here"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";TOKEN ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enable issue by label metrics; default is false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED_ISSUE_BY_LABEL = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enable issue by repository metrics; default is false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED_ISSUE_BY_REPOSITORY = false"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[migrations]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Max attempts per http/https request on migrations."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MAX_ATTEMPTS = 3"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Backoff time per http/https request retry (seconds)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RETRY_BACKOFF = 3"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Allowed domains for migrating, default is blank. Blank means everything will be allowed."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Multiple domains could be separated by commas."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Wildcard is supported: \"github.com, *.github.com\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ALLOWED_DOMAINS ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Blocklist for migrating, default is blank. Multiple domains could be separated by commas."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; When ALLOWED_DOMAINS is not blank, this option has a higher priority to deny domains."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Wildcard is supported."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";BLOCKED_DOMAINS ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Allow private addresses defined by RFC 1918, RFC 1122, RFC 4632 and RFC 4291 (false by default)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If a domain is allowed by ALLOWED_DOMAINS, this option will be ignored."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ALLOW_LOCALNETWORKS = false"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[federation]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enable/Disable federation capabilities"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enable/Disable user statistics for nodeinfo if federation is enabled"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SHARE_USER_STATISTICS = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum federation request and response size (MB)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MAX_SIZE = 4"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; WARNING: Changing the settings below can break federation."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; HTTP signature algorithms"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ALGORITHMS = rsa-sha256, rsa-sha512, ed25519"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; HTTP signature digest algorithm"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DIGEST_ALGORITHM = SHA-256"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; GET headers for federation requests"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";GET_HEADERS = (request-target), Date"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; POST headers for federation requests"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";POST_HEADERS = (request-target), Date, Digest"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[packages]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enable/Disable package registry capabilities"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";STORAGE_TYPE = local"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; override the minio base path if storage type is minio"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MINIO_BASE_PATH = packages/"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; override the azure blob base path if storage type is azureblob"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";AZURE_BLOB_BASE_PATH = packages/"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Allows the storage driver to redirect to authenticated URLs to serve files directly"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Currently, only `minio` and `azureblob` is supported."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SERVE_DIRECT = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum count of package versions a single owner can have (`-1` means no limits)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LIMIT_TOTAL_OWNER_COUNT = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum size of packages a single owner can use (`-1` means no limits, format `1000`, `1 MB`, `1 GiB`)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LIMIT_TOTAL_OWNER_SIZE = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum size of an Alpine upload (`-1` means no limits, format `1000`, `1 MB`, `1 GiB`)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LIMIT_SIZE_ALPINE = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum size of a Cargo upload (`-1` means no limits, format `1000`, `1 MB`, `1 GiB`)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LIMIT_SIZE_CARGO = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum size of a Chef upload (`-1` means no limits, format `1000`, `1 MB`, `1 GiB`)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LIMIT_SIZE_CHEF = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum size of a Composer upload (`-1` means no limits, format `1000`, `1 MB`, `1 GiB`)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LIMIT_SIZE_COMPOSER = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum size of a Conan upload (`-1` means no limits, format `1000`, `1 MB`, `1 GiB`)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LIMIT_SIZE_CONAN = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum size of a Conda upload (`-1` means no limits, format `1000`, `1 MB`, `1 GiB`)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LIMIT_SIZE_CONDA = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum size of a Container upload (`-1` means no limits, format `1000`, `1 MB`, `1 GiB`)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LIMIT_SIZE_CONTAINER = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum size of a CRAN upload (`-1` means no limits, format `1000`, `1 MB`, `1 GiB`)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LIMIT_SIZE_CRAN = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum size of a Debian upload (`-1` means no limits, format `1000`, `1 MB`, `1 GiB`)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LIMIT_SIZE_DEBIAN = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum size of a Generic upload (`-1` means no limits, format `1000`, `1 MB`, `1 GiB`)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LIMIT_SIZE_GENERIC = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum size of a Go upload (`-1` means no limits, format `1000`, `1 MB`, `1 GiB`)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LIMIT_SIZE_GO = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum size of a Helm upload (`-1` means no limits, format `1000`, `1 MB`, `1 GiB`)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LIMIT_SIZE_HELM = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum size of a Maven upload (`-1` means no limits, format `1000`, `1 MB`, `1 GiB`)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LIMIT_SIZE_MAVEN = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum size of a npm upload (`-1` means no limits, format `1000`, `1 MB`, `1 GiB`)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LIMIT_SIZE_NPM = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum size of a NuGet upload (`-1` means no limits, format `1000`, `1 MB`, `1 GiB`)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LIMIT_SIZE_NUGET = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum size of a Pub upload (`-1` means no limits, format `1000`, `1 MB`, `1 GiB`)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LIMIT_SIZE_PUB = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum size of a PyPI upload (`-1` means no limits, format `1000`, `1 MB`, `1 GiB`)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LIMIT_SIZE_PYPI = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum size of a RPM upload (`-1` means no limits, format `1000`, `1 MB`, `1 GiB`)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LIMIT_SIZE_RPM = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum size of a RubyGems upload (`-1` means no limits, format `1000`, `1 MB`, `1 GiB`)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LIMIT_SIZE_RUBYGEMS = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum size of a Swift upload (`-1` means no limits, format `1000`, `1 MB`, `1 GiB`)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LIMIT_SIZE_SWIFT = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum size of a Vagrant upload (`-1` means no limits, format `1000`, `1 MB`, `1 GiB`)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LIMIT_SIZE_VAGRANT = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum size of a Terraform state upload (`-1` means no limits, format `1000`, `1 MB`, `1 GiB`)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LIMIT_SIZE_TERRAFORM_STATE = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enable RPM re-signing by default. (It will overwrite the old signature ,using v4 format, not compatible with CentOS 6 or older)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_RPM_SIGN_ENABLED  = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; default storage for attachments, lfs and avatars"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[storage]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; storage type"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";STORAGE_TYPE = local"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; repo-archive storage will override storage"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[repo-archive]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";STORAGE_TYPE = local"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Where your lfs files reside, default is data/lfs."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PATH = data/repo-archive"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; override the minio base path if storage type is minio"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MINIO_BASE_PATH = repo-archive/"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; override the azure blob base path if storage type is azureblob"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";AZURE_BLOB_BASE_PATH = repo-archive/"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; settings for repository archives, will override storage setting"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[storage.repo-archive]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; storage type"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";STORAGE_TYPE = local"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; lfs storage will override storage"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[lfs]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";STORAGE_TYPE = local"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Where your lfs files reside, default is data/lfs."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PATH = data/lfs"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Allows the storage driver to redirect to authenticated URLs to serve files directly"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Currently, only `minio` and `azureblob` is supported."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SERVE_DIRECT = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; override the minio base path if storage type is minio"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MINIO_BASE_PATH = lfs/"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; override the azure blob base path if storage type is azureblob"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";AZURE_BLOB_BASE_PATH = lfs/"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; settings for Gitea's LFS client (eg: mirroring an upstream lfs endpoint)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[lfs_client]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Limit the number of pointers in each batch request to this number"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";BATCH_SIZE = 20"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Limit the number of concurrent upload/download operations within a batch"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";BATCH_OPERATION_CONCURRENCY = 8"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; settings for packages, will override storage setting"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[storage.packages]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; storage type"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";STORAGE_TYPE = local"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; customize storage"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[storage.minio]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";STORAGE_TYPE = minio"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Minio endpoint to connect only available when STORAGE_TYPE is `minio`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MINIO_ENDPOINT = localhost:9000"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Minio accessKeyID to connect only available when STORAGE_TYPE is `minio`."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If not provided and STORAGE_TYPE is `minio`, will search for credentials in known"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; environment variables (MINIO_ACCESS_KEY_ID, AWS_ACCESS_KEY_ID), credentials files"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; (~/.mc/config.json, ~/.aws/credentials), and EC2 instance metadata."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MINIO_ACCESS_KEY_ID ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Minio secretAccessKey to connect only available when STORAGE_TYPE is `minio`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MINIO_SECRET_ACCESS_KEY ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Preferred IAM Endpoint to override Minio's default IAM Endpoint resolution only available when STORAGE_TYPE is `minio`."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If not provided and STORAGE_TYPE is `minio`, will search for and derive endpoint from known environment variables"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; (AWS_CONTAINER_AUTHORIZATION_TOKEN, AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE, AWS_CONTAINER_CREDENTIALS_RELATIVE_URI,"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; AWS_CONTAINER_CREDENTIALS_FULL_URI, AWS_WEB_IDENTITY_TOKEN_FILE, AWS_ROLE_ARN, AWS_ROLE_SESSION_NAME, AWS_REGION),"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; or the DefaultIAMRoleEndpoint if not provided otherwise."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MINIO_IAM_ENDPOINT ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Minio bucket to store the attachments only available when STORAGE_TYPE is `minio`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MINIO_BUCKET = gitea"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Minio location to create bucket only available when STORAGE_TYPE is `minio`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MINIO_LOCATION = us-east-1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Minio enabled ssl only available when STORAGE_TYPE is `minio`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MINIO_USE_SSL = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Minio skip SSL verification available when STORAGE_TYPE is `minio`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MINIO_INSECURE_SKIP_VERIFY = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Minio bucket lookup method defaults to auto mode; set it to `dns` for virtual host style or `path` for path style, only available when STORAGE_TYPE is `minio`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MINIO_BUCKET_LOOKUP_TYPE = auto"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[storage.azureblob]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";STORAGE_TYPE = azureblob"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Azure Blob endpoint to connect only available when STORAGE_TYPE is `azureblob`,"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; e.g. https://accountname.blob.core.windows.net or http://127.0.0.1:10000/devstoreaccount1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";AZURE_BLOB_ENDPOINT ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Azure Blob account name to connect only available when STORAGE_TYPE is `azureblob`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";AZURE_BLOB_ACCOUNT_NAME ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Azure Blob account key to connect only available when STORAGE_TYPE is `azureblob`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";AZURE_BLOB_ACCOUNT_KEY ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Azure Blob container to store the attachments only available when STORAGE_TYPE is `azureblob`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";AZURE_BLOB_CONTAINER = gitea"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[proxy]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enable the proxy, all requests to external via HTTP will be affected"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PROXY_ENABLED = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Proxy server URL, support http://, https//, socks://, blank will follow environment http_proxy/https_proxy/no_proxy"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PROXY_URL ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Comma separated list of host names requiring proxy. Glob patterns (*) are accepted; use ** to match all hosts."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PROXY_HOSTS ="
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT "; [actions]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enable/Disable actions capabilities"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default platform to get action plugins, `github` for `https://github.com`, `self` for the current Gitea instance."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_ACTIONS_URL = github"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Logs retention time in days. Old logs will be deleted after this period."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LOG_RETENTION_DAYS = 365"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Log compression type, `none` for no compression, `zstd` for zstd compression."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Other compression types like `gzip` are NOT supported, since seekable stream is required for log view."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; It's always recommended to use compression when using local disk as log storage if CPU or memory is not a bottleneck."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; And for object storage services like S3, which is billed for requests, it would cause extra 2 times of get requests for each log view."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; But it will save storage space and network bandwidth, so it's still recommended to use compression."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LOG_COMPRESSION = zstd"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default artifact retention time in days. Artifacts could have their own retention periods by setting the `retention-days` option in `actions/upload-artifact` step."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ARTIFACT_RETENTION_DAYS = 90"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Timeout to stop the task which have running status, but haven't been updated for a long time"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ZOMBIE_TASK_TIMEOUT = 10m"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Timeout to stop the tasks which have running status and continuous updates, but don't end for a long time"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENDLESS_TASK_TIMEOUT = 3h"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Timeout to cancel the jobs which have waiting status, but haven't been picked by a runner for a long time"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ABANDONED_JOB_TIMEOUT = 24h"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Strings committers can place inside a commit message or PR title to skip executing the corresponding actions workflow"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SKIP_WORKFLOW_STRINGS = [skip ci],[ci skip],[no ci],[skip actions],[actions skip]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Comma-separated list of workflow directories, the first one to exist"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; in a repo is used to find Actions workflow files"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";WORKFLOW_DIRS = .gitea/workflows,.github/workflows"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum number of attempts a single workflow run can have. Default value is 50."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MAX_RERUN_ATTEMPTS = 50"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; settings for action logs, will override storage setting"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[storage.actions_log]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; storage type"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";STORAGE_TYPE = local"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[global_lock]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Lock service type, could be memory or redis"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SERVICE_TYPE = memory"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Ignored for the \"memory\" type. For \"redis\" use something like `redis://127.0.0.1:6379/0`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SERVICE_CONN_STR ="
      NEWLINE "\n"
