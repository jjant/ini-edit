      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[cron.cleanup_actions]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RUN_AT_START = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SCHEDULE = @midnight"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Clean-up deleted branches"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[cron.deleted_branches_cleanup]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Clean-up deleted branches when starting server (default true)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RUN_AT_START = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Notice if not success"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";NOTICE_ON_SUCCESS = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Interval as a duration between each synchronization (default every 24h)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SCHEDULE = @midnight"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; deleted branches than OLDER_THAN ago are subject to deletion"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";OLDER_THAN = 24h"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Cleanup hook_task table"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[cron.cleanup_hook_task_table]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Whether to enable the job"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Whether to always run at start up time (if ENABLED)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RUN_AT_START = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Time interval for job to run"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SCHEDULE = @midnight"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; OlderThan or PerWebhook. How the records are removed, either by age (i.e. how long ago hook_task record was delivered) or by the number to keep per webhook (i.e. keep most recent x deliveries per webhook)."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";CLEANUP_TYPE = OlderThan"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If CLEANUP_TYPE is set to OlderThan, then any delivered hook_task records older than this expression will be deleted."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";OLDER_THAN = 168h"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If CLEANUP_TYPE is set to PerWebhook, this is number of hook_task records to keep for a webhook (i.e. keep the most recent x deliveries)."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";NUMBER_TO_KEEP = 10"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Cleanup expired packages"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[cron.cleanup_packages]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Whether to enable the job"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Whether to always run at least once at start up time (if ENABLED)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RUN_AT_START = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Whether to emit notice on successful execution too"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";NOTICE_ON_SUCCESS = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Time interval for job to run"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SCHEDULE = @midnight"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Unreferenced blobs created more than OLDER_THAN ago are subject to deletion"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";OLDER_THAN = 24h"
      NEWLINE "\n"
    BLANK_LINE
