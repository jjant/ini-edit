      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enable running check repository statistics task periodically."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Run check repository statistics task when Gitea starts."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RUN_AT_START = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Notice if not success"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";NOTICE_ON_SUCCESS = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SCHEDULE = @midnight"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[cron.update_migration_poster_id]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT "; Update migrated repositories' issues and comments' posterid, it will always attempt synchronization when the instance starts."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Update migrated repositories' issues and comments' posterid when starting server (default true)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RUN_AT_START = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Notice if not success"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";NOTICE_ON_SUCCESS = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Interval as a duration between each synchronization. (default every 24h)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SCHEDULE = @midnight"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Synchronize external user data (only LDAP user synchronization is supported)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[cron.sync_external_users]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Synchronize external user data when starting server (default false)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RUN_AT_START = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Notice if not success"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";NOTICE_ON_SUCCESS = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Interval as a duration between each synchronization (default every 24h)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SCHEDULE = @midnight"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Create new users, update existing user data and disable users that are not in external source anymore (default)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;   or only create new users if UPDATE_EXISTING is set to false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";UPDATE_EXISTING = true"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
