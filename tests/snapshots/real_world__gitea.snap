---
source: tests/real_world.rs
expression: dump(GITEA)
---
errors: none

ROOT
  COMMENT_LINE
    COMMENT "; This file lists the default values used by Gitea"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";; Copy required sections to your own app.ini (default is custom/conf/app.ini)"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";; and modify as needed."
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";; Do not copy the whole file as-is, as it contains some invalid sections for illustrative purposes."
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";; If you don't know what a setting is you should not set it."
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";; see https://docs.gitea.com/administration/config-cheat-sheet for additional documentation."
    NEWLINE "\n"
  BLANK_LINE
    NEWLINE "\n"
  BLANK_LINE
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";; Default Configuration (non-`app.ini` configuration)"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";; These values are environment-dependent but form the basis of a lot of values. They will be"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";; reported as part of the default configuration when running `gitea help` or on start-up. The order they are emitted there is slightly different but we will list them here in the order they are set-up."
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";; - _`AppPath`_: This is the absolute path of the running gitea binary."
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";; - _`AppWorkPath`_: This refers to \"working path\" of the `gitea` binary. It is determined by using the first set thing in the following hierarchy:"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;   - The \"WORK_PATH\" option in \"app.ini\" file"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;   - The `--work-path` flag passed to the binary"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;   - The environment variable `$GITEA_WORK_DIR`"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;   - A built-in value set at build time (see building from source)"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;   - Otherwise it defaults to the directory of the _`AppPath`_"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;   - If any of the above are relative paths then they are made absolute against the directory of the _`AppPath`_"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";; - _`CustomPath`_: This is the base directory for custom templates and other options. It is determined by using the first set thing in the following hierarchy:"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;   - The `--custom-path` flag passed to the binary"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;   - The environment variable `$GITEA_CUSTOM`"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;   - A built-in value set at build time (see building from source)"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;   - Otherwise it defaults to _`AppWorkPath`_`/custom`"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;   - If any of the above are relative paths then they are made absolute against the directory of the _`AppWorkPath`_"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";; - _`CustomConf`_: This is the path to the `app.ini` file."
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;   - The `--config` flag passed to the binary"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;   - A built-in value set at build time (see building from source)"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;   - Otherwise it defaults to _`CustomPath`_`/conf/app.ini`"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;   - If any of the above are relative paths then they are made absolute against the directory of the _`CustomPath`_"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";; In addition there is _`StaticRootPath`_ which can be set as a built-in at build time, but will otherwise default to _`AppWorkPath`_"
    NEWLINE "\n"
  BLANK_LINE
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";; General Settings"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";; App name that shows in every page title"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";APP_NAME = Gitea: Git with a cup of tea"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";; RUN_USER will automatically detect the current user - but you can set it here change it if you run locally"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";RUN_USER ="
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";; Application run mode, affects performance and debugging: \"dev\" or \"prod\", default is \"prod\""
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";; Mode \"dev\" makes Gitea easier to develop and debug, values other than \"dev\" are treated as \"prod\" which is for production use."
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";RUN_MODE = prod"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";; The working directory, see the comment of AppWorkPath above"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";WORK_PATH ="
    NEWLINE "\n"
  BLANK_LINE
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
    NEWLINE "\n"
  COMMENT_LINE
    COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
    NEWLINE "\n"
  SECTION
    SECTION_HEADER
      L_BRACK "["
      IDENT "server"
      R_BRACK "]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The protocol the server listens on. One of \"http\", \"https\", \"http+unix\", \"fcgi\" or \"fcgi+unix\"."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PROTOCOL = http"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Set the domain for the server."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DOMAIN = localhost"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The AppURL is used to generate public URL links, defaults to \"{PROTOCOL}://{DOMAIN}:{HTTP_PORT}/\"."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Most users should set it to the real website URL of their Gitea instance when there is a reverse proxy."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ROOT_URL ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Controls how to detect the public URL. Most instances should use the \"auto\" behavior,"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; especially when the Gitea instance needs to be accessed in a container network."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; * legacy: (default <= 1.25) detect the public URL from \"Host\" header if \"X-Forwarded-Proto\" header exists, otherwise use \"ROOT_URL\"."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; * auto: (default >= 1.26) always use \"Host\" header, and also use \"X-Forwarded-Proto\" header if it exists. If no \"Host\" header, use \"ROOT_URL\"."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; * never: always use \"ROOT_URL\", never detect from request headers."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PUBLIC_URL_DETECTION = auto"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; For development purpose only. It makes Gitea handle sub-path (\"/sub-path/owner/repo/...\") directly when debugging without a reverse proxy."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; DO NOT USE IT IN PRODUCTION!!!"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";USE_SUB_URL_PATH = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; when STATIC_URL_PREFIX is empty it will follow ROOT_URL"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";STATIC_URL_PREFIX ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The address to listen on. Either a IPv4/IPv6 address or the path to a unix socket."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If PROTOCOL is set to \"http+unix\" or \"fcgi+unix\", this should be the name of the Unix socket file to use."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Relative paths will be made absolute against the _`AppWorkPath`_."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";HTTP_ADDR = 0.0.0.0"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The port to listen on for \"http\" or \"https\" protocol. Leave empty when using a unix socket."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";HTTP_PORT = 3000"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Expect PROXY protocol headers on connections"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";USE_PROXY_PROTOCOL = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Use PROXY protocol in TLS Bridging mode"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PROXY_PROTOCOL_TLS_BRIDGING = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Timeout to wait for PROXY protocol header (set to 0 to have no timeout)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PROXY_PROTOCOL_HEADER_TIMEOUT = 5s"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Accept PROXY protocol headers with UNKNOWN type"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PROXY_PROTOCOL_ACCEPT_UNKNOWN = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If REDIRECT_OTHER_PORT is true, and PROTOCOL is set to https an http server"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; will be started on PORT_TO_REDIRECT and it will redirect plain, non-secure http requests to the main"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; ROOT_URL.  Defaults are false for REDIRECT_OTHER_PORT and 80 for"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; PORT_TO_REDIRECT."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REDIRECT_OTHER_PORT = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PORT_TO_REDIRECT = 80"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; expect PROXY protocol header on connections to https redirector, defaults to USE_PROXY_PROTOCOL"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REDIRECTOR_USE_PROXY_PROTOCOL ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Minimum and maximum supported TLS versions"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SSL_MIN_VERSION=TLSv1.2"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SSL_MAX_VERSION="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; SSL Curve Preferences"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SSL_CURVE_PREFERENCES=X25519,P256"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; SSL Cipher Suites"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SSL_CIPHER_SUITES=; Will default to \"ecdhe_ecdsa_with_aes_256_gcm_sha384,ecdhe_rsa_with_aes_256_gcm_sha384,ecdhe_ecdsa_with_aes_128_gcm_sha256,ecdhe_rsa_with_aes_128_gcm_sha256,ecdhe_ecdsa_with_chacha20_poly1305,ecdhe_rsa_with_chacha20_poly1305\" if aes is supported by hardware, otherwise chacha will be first."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Timeout for any write to the connection. (Set to -1 to disable all timeouts.)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PER_WRITE_TIMEOUT = 30s"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Timeout per Kb written to connections."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PER_WRITE_PER_KB_TIMEOUT = 30s"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Permission for unix socket"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";UNIX_SOCKET_PERMISSION = 666"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Local (DMZ) URL for Gitea workers (such as SSH update) accessing web service. In"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; most cases you do not need to change the default value. Alter it only if"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; your SSH server node is not the same as HTTP node. For different protocol, the default"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; values are different. If `PROTOCOL` is `http+unix`, the default value is `http://unix/`."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If `PROTOCOL` is `fcgi` or `fcgi+unix`, the default value is `{PROTOCOL}://{HTTP_ADDR}:{HTTP_PORT}/`."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If listen on `0.0.0.0`, the default value is `{PROTOCOL}://localhost:{HTTP_PORT}/`."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Otherwise the default value is `{PROTOCOL}://{HTTP_ADDR}:{HTTP_PORT}/`."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Most users don't need (and shouldn't) set this value."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LOCAL_ROOT_URL ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; When making local connections pass the PROXY protocol header, defaults to USE_PROXY_PROTOCOL"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LOCAL_USE_PROXY_PROTOCOL ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Disable SSH feature when not available"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DISABLE_SSH = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Whether to use the builtin SSH server or not."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";START_SSH_SERVER = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Expect PROXY protocol header on connections to the built-in SSH server"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SSH_SERVER_USE_PROXY_PROTOCOL = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Username to use for the builtin SSH server. If blank, then it is the value of RUN_USER."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";BUILTIN_SSH_SERVER_USER ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Domain name to be exposed in clone URL, defaults to DOMAIN or the domain part of ROOT_URL"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SSH_DOMAIN ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Port number to be exposed in clone URL."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If you need a different \"SSH clone port\" from the real \"SSH listen port\", set the SSH_LISTEN_PORT separately."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SSH_PORT = 22"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The network interface that the builtin SSH server should listen on"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SSH_LISTEN_HOST ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The port number that the builtin SSH server should listen on, defaults to SSH_PORT"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SSH_LISTEN_PORT ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; SSH username displayed in clone URLs. It defaults to BUILTIN_SSH_SERVER_USER or RUN_USER."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If it is set to \"(DOER_USERNAME)\", it will use current signed-in user's username."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; This option is only for some advanced users who have configured their SSH reverse-proxy"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; and need to use different usernames for git SSH clone."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Most users should just leave it blank."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SSH_USER ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Root path of SSH user directory for the system's standalone SSH server if Gitea is not using its builtin SSH server."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default is the '.ssh' directory in the run user's home directory."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SSH_ROOT_PATH ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Gitea will create an authorized_keys file by default when it is not using the builtin SSH server"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If you intend to use the AuthorizedKeysCommand functionality then you should turn this off."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SSH_CREATE_AUTHORIZED_KEYS_FILE = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Gitea will create an authorized_principals file by default when it is not using the builtin SSH server"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If you intend to use the AuthorizedPrincipalsCommand functionality then you should turn this off."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SSH_CREATE_AUTHORIZED_PRINCIPALS_FILE = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; For the builtin SSH server, choose the supported ciphers/key-exchange-algorithms/MACs for SSH connections."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The supported names are listed in https://github.com/golang/crypto/blob/master/ssh/common.go."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Leave them empty to use the Golang crypto's recommended default values."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; For system SSH (non-builtin SSH server), this setting has no effect."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SSH_SERVER_CIPHERS ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SSH_SERVER_KEY_EXCHANGES ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SSH_SERVER_MACS ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; For the built-in SSH server, choose the keypair to offer as the host key"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The private key should be at SSH_SERVER_HOST_KEY and the public SSH_SERVER_HOST_KEY.pub"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; relative paths are made absolute relative to the APP_DATA_PATH"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SSH_SERVER_HOST_KEYS=ssh/gitea.rsa, ssh/gogs.rsa"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enable SSH Authorized Key Backup when rewriting all keys, default is false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SSH_AUTHORIZED_KEYS_BACKUP = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Determines which principals to allow"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - empty: if SSH_TRUSTED_USER_CA_KEYS is empty this will default to off, otherwise will default to email, username."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - off: Do not allow authorized principals"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - email: the principal must match the user's email"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - username: the principal must match the user's username"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - anything: there will be no checking on the content of the principal"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SSH_AUTHORIZED_PRINCIPALS_ALLOW = email, username"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enable SSH Authorized Principals Backup when rewriting all keys, default is true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SSH_AUTHORIZED_PRINCIPALS_BACKUP = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Specifies the public keys of certificate authorities that are trusted to sign user certificates for authentication."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Multiple keys should be comma separated."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; E.g.\"ssh-<algorithm> <key>\". or \"ssh-<algorithm> <key1>, ssh-<algorithm> <key2>\"."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; For more information see \"TrustedUserCAKeys\" in the sshd config manpages."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SSH_TRUSTED_USER_CA_KEYS ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Absolute path of the `TrustedUserCaKeys` file gitea will manage."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default this `RUN_USER`/.ssh/gitea-trusted-user-ca-keys.pem"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If you're running your own ssh server and you want to use the gitea managed file you'll also need to modify your"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; sshd_config to point to this file. The official docker image will automatically work without further configuration."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SSH_TRUSTED_USER_CA_KEYS_FILENAME ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enable exposure of SSH clone URL to anonymous visitors, default is false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SSH_EXPOSE_ANONYMOUS = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Timeout for any write to ssh connections. (Set to -1 to disable all timeouts.)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Will default to the PER_WRITE_TIMEOUT."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SSH_PER_WRITE_TIMEOUT = 30s"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Timeout per Kb written to ssh connections."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Will default to the PER_WRITE_PER_KB_TIMEOUT."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SSH_PER_WRITE_PER_KB_TIMEOUT = 30s"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Indicate whether to check minimum key size with corresponding type"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MINIMUM_KEY_SIZE_CHECK = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; TLS Settings: Either ACME or manual"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; (Other common TLS configuration are found before)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_ACME = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; ACME automatic TLS settings"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; ACME directory URL (e.g. LetsEncrypt's staging/testing URL: https://acme-staging-v02.api.letsencrypt.org/directory)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Leave empty to default to LetsEncrypt's (production) URL"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ACME_URL ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Explicitly accept the ACME's TOS. The specific TOS cannot be retrieved at the moment."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ACME_ACCEPTTOS = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If the ACME CA is not in your system's CA trust chain, it can be manually added here"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ACME_CA_ROOT ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Email used for the ACME registration service"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Can be left blank to initialize at first run and use the cached value"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ACME_EMAIL ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; ACME live directory (not to be confused with ACME directory URL: ACME_URL)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; (Refer to caddy's ACME manager https://github.com/caddyserver/certmagic)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ACME_DIRECTORY = https"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;  Manual TLS settings: (Only applicable if ENABLE_ACME=false)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Generate steps:"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; $ ./gitea cert -ca=true -duration=8760h0m0s -host=myhost.example.com"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Or from a .pfx file exported from the Windows certificate store (do"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; not forget to export the private key):"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; $ openssl pkcs12 -in cert.pfx -out cert.pem -nokeys"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; $ openssl pkcs12 -in cert.pfx -out key.pem -nocerts -nodes"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Paths are relative to CUSTOM_PATH"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";CERT_FILE = https/cert.pem"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";KEY_FILE = https/key.pem"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Root directory containing templates and static files."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; default is the path where Gitea is executed"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";STATIC_ROOT_PATH = ; Will default to the built-in value _`StaticRootPath`_"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default path for App data"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";APP_DATA_PATH = data ; relative paths will be made absolute with _`AppWorkPath`_"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Base path for App's temp files, leave empty to use the managed tmp directory in APP_DATA_PATH"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";APP_TEMP_PATH ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enable gzip compression for runtime-generated content, static resources excluded"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_GZIP = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Application profiling (memory and cpu)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; For \"web\" command it listens on localhost:6060"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; For \"serve\" command it dumps to disk at PPROF_DATA_PATH as (cpuprofile|memprofile)_<username>_<temporary id>"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_PPROF = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; PPROF_DATA_PATH, use an absolute path when you start gitea as service"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PPROF_DATA_PATH = data/tmp/pprof ; Path is relative to _`AppWorkPath`_"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Landing page, can be \"home\", \"explore\", \"organizations\", \"login\", or any URL such as \"/org/repo\" or even \"https://anotherwebsite.com\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The \"login\" choice is not a security measure but just a UI flow change, use REQUIRE_SIGNIN_VIEW to force users to log in."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LANDING_PAGE = home"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enables git-lfs support. true or false, default is false."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LFS_START_SERVER = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enables git-lfs SSH protocol support. true or false, default is false."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LFS_ALLOW_PURE_SSH = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; LFS authentication secret, change this yourself"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LFS_JWT_SECRET ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Alternative location to specify LFS authentication secret. You cannot specify both this and LFS_JWT_SECRET, and must pick one"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LFS_JWT_SECRET_URI = file:/etc/gitea/lfs_jwt_secret"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; LFS authentication validity period (in time.Duration), pushes taking longer than this may fail."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LFS_HTTP_AUTH_EXPIRY = 24h"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum allowed LFS file size in bytes (Set to 0 for no limit)."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LFS_MAX_FILE_SIZE = 0"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum number of locks returned per page"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LFS_LOCKS_PAGING_NUM = 50"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; When clients make lfs batch requests, reject them if there are more pointers than this number"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; zero means 'unlimited'"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LFS_MAX_BATCH_SIZE = 0"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Allow graceful restarts using SIGHUP to fork"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ALLOW_GRACEFUL_RESTARTS = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; After a restart the parent will finish ongoing requests before"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; shutting down. Force shutdown if this process takes longer than this delay."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; set to a negative value to disable"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";GRACEFUL_HAMMER_TIME = 60s"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Allows the setting of a startup timeout and waithint for Windows as SVC service"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; 0 disables this."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";STARTUP_TIMEOUT = 0"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Static resources, includes resources on custom/, public/ and all uploaded avatars web browser cache time. Note that this cache is disabled when RUN_MODE is \"dev\". Default is 6h"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";STATIC_CACHE_TIME = 6h"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
  SECTION
    SECTION_HEADER
      L_BRACK "["
      IDENT "database"
      R_BRACK "]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Database to use. Either \"mysql\", \"postgres\", \"mssql\" or \"sqlite3\"."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; MySQL Configuration"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    ENTRY
      KEY
        IDENT "DB_TYPE"
      WHITESPACE " "
      EQ "="
      WHITESPACE " "
      VALUE
        VALUE_TEXT "mysql"
      NEWLINE "\n"
    ENTRY
      KEY
        IDENT "HOST"
      WHITESPACE " "
      EQ "="
      WHITESPACE " "
      VALUE
        VALUE_TEXT "127.0.0.1:3306 ; can use socket e.g. /var/run/mysqld/mysqld.sock"
      NEWLINE "\n"
    ENTRY
      KEY
        IDENT "NAME"
      WHITESPACE " "
      EQ "="
      WHITESPACE " "
      VALUE
        VALUE_TEXT "gitea"
      NEWLINE "\n"
    ENTRY
      KEY
        IDENT "USER"
      WHITESPACE " "
      EQ "="
      WHITESPACE " "
      VALUE
        VALUE_TEXT "root"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PASSWD = ;Use PASSWD = `your password` for quoting if you use special characters in the password."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SSL_MODE = false ; either \"false\" (default), \"true\", or \"skip-verify\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";CHARSET_COLLATION = ; Empty as default, Gitea will try to find a case-sensitive collation. Don't change it unless you clearly know what you need."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Postgres Configuration"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DB_TYPE = postgres"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";HOST = 127.0.0.1:5432 ; can use socket e.g. /var/run/postgresql/"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";NAME = gitea"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";USER = root"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PASSWD ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SCHEMA ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SSL_MODE=disable ;either \"disable\" (default), \"require\", or \"verify-full\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; SQLite Configuration"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DB_TYPE = sqlite3"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PATH= ; defaults to data/gitea.db"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SQLITE_TIMEOUT = ; Query timeout in milliseconds, defaults to: 20000"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SQLITE_JOURNAL_MODE = ; defaults to sqlite database default (often DELETE), can be used to enable WAL mode. https://www.sqlite.org/pragma.html#pragma_journal_mode"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; MSSQL Configuration"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DB_TYPE = mssql"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";HOST = 172.17.0.2:1433"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";NAME = gitea"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";USER = SA"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PASSWD = MwantsaSecurePassword1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";CHARSET_COLLATION = ; Empty as default, Gitea will try to find a case-sensitive collation. Don't change it unless you clearly know what you need."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Other settings"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; For iterate buffer, default is 50"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ITERATE_BUFFER_SIZE = 50"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Show the database generated SQL"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LOG_SQL = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum number of DB Connect retries"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DB_RETRIES = 10"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Backoff time per DB retry (time.Duration)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DB_RETRY_BACKOFF = 3s"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Max idle database connections on connection pool, default is 2"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MAX_IDLE_CONNS = 2"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Database connection max life time, default is 0 or 3s mysql (See #6804 & #7071 for reasoning)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";CONN_MAX_LIFETIME = 3s"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Database maximum number of open connections, default is 0 meaning no maximum"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MAX_OPEN_CONNS = 0"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Whether execute database models migrations automatically"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";AUTO_MIGRATION = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Threshold value (in seconds) beyond which query execution time is logged as a warning in the xorm logger"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SLOW_QUERY_THRESHOLD = 5s"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
  SECTION
    SECTION_HEADER
      L_BRACK "["
      IDENT "security"
      R_BRACK "]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Whether the installer is disabled (set to true to disable the installer)"
      NEWLINE "\n"
    ENTRY
      KEY
        IDENT "INSTALL_LOCK"
      WHITESPACE " "
      EQ "="
      WHITESPACE " "
      VALUE
        VALUE_TEXT "false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Global secret key that will be used"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; This key is VERY IMPORTANT. If you lose it, the data encrypted by it (like 2FA secret) can't be decrypted anymore."
      NEWLINE "\n"
    ENTRY
      KEY
        IDENT "SECRET_KEY"
      WHITESPACE " "
      EQ "="
      VALUE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Alternative location to specify secret key, instead of this file; you cannot specify both this and SECRET_KEY, and must pick one"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; This key is VERY IMPORTANT. If you lose it, the data encrypted by it (like 2FA secret) can't be decrypted anymore."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SECRET_KEY_URI = file:/etc/gitea/secret_key"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Secret used to validate communication within Gitea binary."
      NEWLINE "\n"
    ENTRY
      KEY
        IDENT "INTERNAL_TOKEN"
      WHITESPACE " "
      EQ "="
      VALUE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Alternative location to specify internal token, instead of this file; you cannot specify both this and INTERNAL_TOKEN, and must pick one"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";INTERNAL_TOKEN_URI = file:/etc/gitea/internal_token"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; How long to remember that a user is logged in before requiring relogin (in days)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LOGIN_REMEMBER_DAYS = 31"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Name of the cookie used to store the current username."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";COOKIE_USERNAME = gitea_awesome"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Name of cookie used to store authentication information."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";COOKIE_REMEMBER_NAME = gitea_incredible"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; URL or path that Gitea should redirect users to *after* performing its own logout."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Use this, if needed, when authentication is handled by a reverse proxy or SSO."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; For example: \"/my-sso/logout?return=/my-sso/home\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REVERSE_PROXY_LOGOUT_REDIRECT ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Reverse proxy authentication header name of user name, email, and full name"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REVERSE_PROXY_AUTHENTICATION_USER = X-WEBAUTH-USER"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REVERSE_PROXY_AUTHENTICATION_EMAIL = X-WEBAUTH-EMAIL"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REVERSE_PROXY_AUTHENTICATION_FULL_NAME = X-WEBAUTH-FULLNAME"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Interpret X-Forwarded-For header or the X-Real-IP header and set this as the remote IP for the request"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REVERSE_PROXY_LIMIT = 1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; List of IP addresses and networks separated by comma of trusted proxy servers. Use `*` to trust all."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REVERSE_PROXY_TRUSTED_PROXIES = 127.0.0.0/8,::1/128"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The minimum password length for new Users"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MIN_PASSWORD_LENGTH = 8"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Set to true to allow users to import local server paths"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";IMPORT_LOCAL_PATHS = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Set to false to allow users with git hook privileges to create custom git hooks."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Custom git hooks can be used to perform arbitrary code execution on the host operating system."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; This enables the users to access and modify this config file and the Gitea database and interrupt the Gitea service."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; By modifying the Gitea database, users can gain Gitea administrator privileges."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; It also enables them to access other resources available to the user on the operating system that is running the Gitea instance and perform arbitrary actions in the name of the Gitea OS user."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; WARNING: This maybe harmful to you website or your operating system."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; WARNING: Setting this to true does not change existing hooks in git repos; adjust it before if necessary."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DISABLE_GIT_HOOKS = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Set to true to disable webhooks feature."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DISABLE_WEBHOOKS = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Set to false to allow pushes to gitea repositories despite having an incomplete environment - NOT RECOMMENDED"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ONLY_ALLOW_PUSH_IF_GITEA_ENVIRONMENT_SET = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;Comma separated list of character classes required to pass minimum complexity."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;If left empty or no valid values are specified, the default is off (no checking)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;Classes include \"lower,upper,digit,spec\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PASSWORD_COMPLEXITY = off"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Password Hash algorithm, either \"argon2\", \"pbkdf2\", \"scrypt\" or \"bcrypt\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PASSWORD_HASH_ALGO = pbkdf2"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Validate against https://haveibeenpwned.com/Passwords to see if a password has been exposed"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PASSWORD_CHECK_PWN = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Cache successful token hashes. API tokens are stored in the DB as pbkdf2 hashes however, this means that there is a potentially significant hashing load when there are multiple API operations."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; This cache will store the successfully hashed tokens in a LRU cache as a balance between performance and security."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SUCCESSFUL_TOKENS_CACHE_SIZE = 20"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Reject API tokens sent in URL query string (Accept Header-based API tokens only). This avoids security vulnerabilities"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; stemming from cached/logged plain-text API tokens."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; In future releases, this will become the default behavior"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DISABLE_QUERY_AUTH_TOKEN = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; On user registration, record the IP address and user agent of the user to help identify potential abuse."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; RECORD_USER_SIGNUP_METADATA = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Set the two-factor auth behavior."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Set to \"enforced\", to force users to enroll into Two-Factor Authentication, users without 2FA have no access to repositories via API or web."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";TWO_FACTOR_AUTH ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The value of the X-Frame-Options HTTP header for all responses. Use \"unset\" to remove the header."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";X_FRAME_OPTIONS = SAMEORIGIN"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The value of the X-Content-Type-Options HTTP header for all responses. Use \"unset\" to remove the header."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";X_CONTENT_TYPE_OPTIONS = nosniff"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
  SECTION
    SECTION_HEADER
      L_BRACK "["
      IDENT "camo"
      R_BRACK "]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; At the moment we only support images"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; if the camo is enabled"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; url to a camo image proxy, it **is required** if camo is enabled."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SERVER_URL ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; HMAC to encode urls with, it **is required** if camo is enabled."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";HMAC_KEY ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Set to true to use camo for https too lese only non https urls are proxyed"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; ALLWAYS is deprecated and will be removed in the future"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ALWAYS = false"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
  SECTION
    SECTION_HEADER
      L_BRACK "["
      IDENT "oauth2"
      R_BRACK "]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enables OAuth2 provider"
      NEWLINE "\n"
    ENTRY
      KEY
        IDENT "ENABLED"
      WHITESPACE " "
      EQ "="
      WHITESPACE " "
      VALUE
        VALUE_TEXT "true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Algorithm used to sign OAuth2 tokens. Valid values: HS256, HS384, HS512, RS256, RS384, RS512, ES256, ES384, ES512, EdDSA"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";JWT_SIGNING_ALGORITHM = RS256"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Private key file path used to sign OAuth2 tokens. The path is relative to APP_DATA_PATH."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; This setting is only needed if JWT_SIGNING_ALGORITHM is set to RS256, RS384, RS512, ES256, ES384 or ES512."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The file must contain a RSA or ECDSA private key in the PKCS8 format. If no key exists a 4096 bit key will be created for you."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";JWT_SIGNING_PRIVATE_KEY_FILE = jwt/private.pem"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; OAuth2 authentication secret for access and refresh tokens, change this yourself to a unique string. CLI generate option is helpful in this case. https://docs.gitea.io/en-us/command-line/#generate"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; This setting is only needed if JWT_SIGNING_ALGORITHM is set to HS256, HS384 or HS512."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";JWT_SECRET ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Alternative location to specify OAuth2 authentication secret. You cannot specify both this and JWT_SECRET, and must pick one"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";JWT_SECRET_URI = file:/etc/gitea/oauth2_jwt_secret"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The \"issuer\" claim identifies the principal that issued the JWT."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Gitea 1.25 makes it default to \"ROOT_URL without the last slash\" to follow the standard."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If you have old logins from before 1.25, you may want to set it to the old (non-standard) value \"ROOT_URL with the last slash\"."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";JWT_CLAIM_ISSUER ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Lifetime of an OAuth2 access token in seconds"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ACCESS_TOKEN_EXPIRATION_TIME = 3600"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Lifetime of an OAuth2 refresh token in hours"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REFRESH_TOKEN_EXPIRATION_TIME = 730"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Check if refresh token got already used"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";INVALIDATE_REFRESH_TOKENS = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum length of oauth2 token/cookie stored on server"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MAX_TOKEN_LENGTH = 32767"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Pre-register OAuth2 applications for some universally useful services"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; * https://github.com/hickford/git-credential-oauth"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; * https://github.com/git-ecosystem/git-credential-manager"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; * https://gitea.com/gitea/tea"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_APPLICATIONS = git-credential-oauth, git-credential-manager, tea"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; By default, OAuth2 applications can only use \"http\" and \"https\" as their redirect URI schemes."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If you need to use other schemes (e.g. for desktop applications), you can specify them here as a comma-separated list."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; For example: set \"my-scheme, com.example.app\" to support \"my-scheme://...\" and \"com.example.app://...\" redirect URIs."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";CUSTOM_SCHEMES ="
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
  SECTION
    SECTION_HEADER
      L_BRACK "["
      IDENT "log"
      R_BRACK "]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Root path for the log files - defaults to \"{AppWorkPath}/log\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ROOT_PATH ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Main Logger"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Either \"console\", \"file\" or \"conn\", default is \"console\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Use comma to separate multiple modes, e.g. \"console, file\""
      NEWLINE "\n"
    ENTRY
      KEY
        IDENT "MODE"
      WHITESPACE " "
      EQ "="
      WHITESPACE " "
      VALUE
        VALUE_TEXT "console"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Either \"Trace\", \"Debug\", \"Info\", \"Warn\", \"Error\" or \"None\", default is \"Info\""
      NEWLINE "\n"
    ENTRY
      KEY
        IDENT "LEVEL"
      WHITESPACE " "
      EQ "="
      WHITESPACE " "
      VALUE
        VALUE_TEXT "Info"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Print Stacktrace with logs (rarely helpful, do not set) Either \"Trace\", \"Debug\", \"Info\", \"Warn\", \"Error\", default is \"None\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";STACKTRACE_LEVEL = None"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Buffer length of the channel, keep it as it is if you don't know what it is."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";BUFFER_LEN = 10000"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Sub logger modes, a single comma means use default MODE above, empty means disable it"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";logger.access.MODE="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";logger.router.MODE=,"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";logger.xorm.MODE=,"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Collect SSH logs (Creates log from ssh git request)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_SSH_LOG = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Access Logger (Creates log in NCSA common log format)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Print request id which parsed from request headers in access log, when access log is enabled."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; * E.g:"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; * In request Header:         X-Request-ID: test-id-123"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; * Configuration in app.ini:  REQUEST_ID_HEADERS = X-Request-ID"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; * Print in log:              127.0.0.1:58384 - - [14/Feb/2023:16:33:51 +0800] \"test-id-123\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If you configure more than one in the .ini file, it will match in the order of configuration,"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; and the first match will be finally printed in the log."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; * E.g:"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; * In request Header:         X-Trace-ID: trace-id-1q2w3e4r"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; * Configuration in app.ini:  REQUEST_ID_HEADERS = X-Request-ID, X-Trace-ID, X-Req-ID"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; * Print in log:              127.0.0.1:58384 - - [14/Feb/2023:16:33:51 +0800] \"trace-id-1q2w3e4r\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REQUEST_ID_HEADERS ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Sets the template used to create the access log."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ACCESS_LOG_TEMPLATE = {{.Ctx.RemoteHost}} - {{.Identity}} {{.Start.Format \"[02/Jan/2006:15:04:05 -0700]\" }} \"{{.Ctx.Req.Method}} {{.Ctx.Req.URL.RequestURI}} {{.Ctx.Req.Proto}}\" {{.ResponseWriter.Status}} {{.ResponseWriter.Size}} \"{{.Ctx.Req.Referer}}\" \"{{.Ctx.Req.UserAgent}}\""
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Log modes (aka log writers)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[log.%(WriterMode)]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MODE=console/file/conn/..."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LEVEL="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";FLAGS = stdflags"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";EXPRESSION ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PREFIX ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";COLORIZE = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[log.console]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";STDERR = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[log.file]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Set the file_name for the logger. If this is a relative path this will be relative to ROOT_PATH"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";FILE_NAME ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; This enables automated log rotate(switch of following options), default is true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LOG_ROTATE = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Max size shift of a single file, default is 28 means 1 << 28, 256MB"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MAX_SIZE_SHIFT = 28"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Segment log daily, default is true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DAILY_ROTATE = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; delete the log file after n days, default is 7"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MAX_DAYS = 7"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; compress logs with gzip"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";COMPRESS = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; compression level see godoc for compress/gzip"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";COMPRESSION_LEVEL = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[log.conn]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Reconnect host for every single message, default is false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RECONNECT_ON_MSG = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Try to reconnect when connection is lost, default is false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RECONNECT = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Either \"tcp\", \"unix\" or \"udp\", default is \"tcp\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PROTOCOL = tcp"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Host address"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ADDR ="
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
  SECTION
    SECTION_HEADER
      L_BRACK "["
      IDENT "git"
      R_BRACK "]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The path of git executable. If empty, Gitea searches through the PATH environment."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PATH ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The HOME directory for Git, defaults to \"{APP_DATA_PATH}/home\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";HOME_PATH ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Disables highlight of added and removed changes"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DISABLE_DIFF_HIGHLIGHT = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Max number of lines allowed in a single file in diff view"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MAX_GIT_DIFF_LINES = 1000"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Max number of allowed characters in a line in diff view"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MAX_GIT_DIFF_LINE_CHARACTERS = 5000"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Max number of files shown in diff view"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MAX_GIT_DIFF_FILES = 100"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Set the default commits range size"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";COMMITS_RANGE_SIZE = 50"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Set the default branches range size"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";BRANCHES_RANGE_SIZE = 20"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Arguments for command 'git gc', e.g. \"--aggressive --auto\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; see more on http://git-scm.com/docs/git-gc/"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";GC_ARGS ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If use git wire protocol version 2 when git version >= 2.18, default is true, set to false when you always want git wire protocol version 1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; To enable this for Git over SSH when using a OpenSSH server, add `AcceptEnv GIT_PROTOCOL` to your sshd_config file."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_AUTO_GIT_WIRE_PROTOCOL = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Respond to pushes to a non-default branch with a URL for creating a Pull Request (if the repository has them enabled)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PULL_REQUEST_PUSH_MESSAGE = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; (Go-Git only) Don't cache objects greater than this in memory. (Set to 0 to disable.)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LARGE_OBJECT_THRESHOLD = 1048576"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Set to true to forcibly set core.protectNTFS=false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DISABLE_CORE_PROTECT_NTFS=false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Disable the usage of using partial clones for git."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DISABLE_PARTIAL_CLONE = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Set the similarity threshold passed to git commands via `--find-renames=<threshold>`."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default is 50%, the same as git. Must be a integer percentage between 0% and 100%."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DIFF_RENAME_SIMILARITY_THRESHOLD = 50%"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Git Operation timeout in seconds"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[git.timeout]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MIGRATE = 600"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MIRROR = 300"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";GC = 60"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Git config options"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; This section only does \"set\" config, a removed config key from this section won't be removed from git config automatically. The format is `some.configKey = value`."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[git.config]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";diff.algorithm = histogram"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";core.logAllRefUpdates = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";gc.reflogExpire = 90"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
  SECTION
    SECTION_HEADER
      L_BRACK "["
      IDENT "service"
      R_BRACK "]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Time limit to confirm account/email registration"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ACTIVE_CODE_LIVE_MINUTES = 180"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Time limit to perform the reset of a forgotten password"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RESET_PASSWD_CODE_LIVE_MINUTES = 180"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Whether a new user needs to confirm their email when registering."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REGISTER_EMAIL_CONFIRM = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Whether a new user needs to be confirmed manually after registration. (Requires `REGISTER_EMAIL_CONFIRM` to be disabled.)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REGISTER_MANUAL_CONFIRM = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; List of domain names that are allowed to be used to register on a Gitea instance, wildcard is supported"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; eg: gitea.io,example.com,*.mydomain.com"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";EMAIL_DOMAIN_ALLOWLIST ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Comma-separated list of domain names that are not allowed to be used to register on a Gitea instance, wildcard is supported"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";EMAIL_DOMAIN_BLOCKLIST ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Disallow registration, only allow admins to create accounts."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DISABLE_REGISTRATION = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Allow registration only using gitea itself, it works only when DISABLE_REGISTRATION is false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ALLOW_ONLY_INTERNAL_REGISTRATION = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Allow registration only using third-party services, it works only when DISABLE_REGISTRATION is false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ALLOW_ONLY_EXTERNAL_REGISTRATION = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; User must sign in to view anything."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; It could be set to \"expensive\" to block anonymous users accessing some pages which consume a lot of resources,"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; for example: block anonymous AI crawlers from accessing repo code pages."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The \"expensive\" mode is experimental and subject to change."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REQUIRE_SIGNIN_VIEW = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Mail notification"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_NOTIFY_MAIL = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; This setting enables gitea to be signed in with HTTP BASIC Authentication using the user's password"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If you set this to false you will not be able to access the tokens endpoints on the API with your password"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Please note that setting this to false will not disable OAuth Basic or Basic authentication using a token"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_BASIC_AUTHENTICATION = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Show the password sign-in form (for password-based login), otherwise, only show OAuth2 or passkey login methods if they are enabled."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If you set it to false, maybe it also needs to set ENABLE_BASIC_AUTHENTICATION to false to completely disable password-based authentication."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_PASSWORD_SIGNIN_FORM = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Allow users to sign-in with a passkey"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_PASSKEY_AUTHENTICATION = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; More detail: https://github.com/gogits/gogs/issues/165"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_REVERSE_PROXY_AUTHENTICATION = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT "; Enable this to allow reverse proxy authentication for API requests, the reverse proxy is responsible for ensuring that no CSRF is possible."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_REVERSE_PROXY_AUTHENTICATION_API = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_REVERSE_PROXY_AUTO_REGISTRATION = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_REVERSE_PROXY_EMAIL = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_REVERSE_PROXY_FULL_NAME = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enable captcha validation for registration"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_CAPTCHA = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enable this to require captcha validation for login"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REQUIRE_CAPTCHA_FOR_LOGIN = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Type of captcha you want to use. Options: image, recaptcha, hcaptcha, mcaptcha, cfturnstile."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";CAPTCHA_TYPE = image"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Change this to use recaptcha.net or other recaptcha service"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RECAPTCHA_URL = https://www.google.com/recaptcha/"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enable recaptcha to use Google's recaptcha service"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Go to https://www.google.com/recaptcha/admin to sign up for a key"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RECAPTCHA_SECRET ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RECAPTCHA_SITEKEY ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; For hCaptcha, create an account at https://accounts.hcaptcha.com/login to get your keys"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";HCAPTCHA_SECRET ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";HCAPTCHA_SITEKEY ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Change this to use demo.mcaptcha.org or your self-hosted mcaptcha.org instance."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MCAPTCHA_URL = https://demo.mcaptcha.org"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Go to your configured mCaptcha instance and register a sitekey"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; and use your account's secret."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MCAPTCHA_SECRET ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MCAPTCHA_SITEKEY ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Go to https://dash.cloudflare.com/?to=/:account/turnstile to sign up for a key"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";CF_TURNSTILE_SITEKEY ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";CF_TURNSTILE_SECRET ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default value for KeepEmailPrivate"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Each new user will get the value of this setting copied into their profile"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_KEEP_EMAIL_PRIVATE = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default value for AllowCreateOrganization"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Every new user will have rights set to create organizations depending on this setting"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_ALLOW_CREATE_ORGANIZATION = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default value for IsRestricted"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Every new user will have restricted permissions depending on this setting"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_USER_IS_RESTRICTED = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Either \"public\", \"limited\" or \"private\", default is \"public\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Limited is for users visible only to signed users"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Private is for users visible only to members of their organizations"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Public is for users visible for everyone"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_USER_VISIBILITY = public"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Set which visibility modes a user can have"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ALLOWED_USER_VISIBILITY_MODES = public,limited,private"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Either \"public\", \"limited\" or \"private\", default is \"public\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Limited is for organizations visible only to signed users"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Private is for organizations visible only to members of the organization"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Public is for organizations visible to everyone"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_ORG_VISIBILITY = public"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default value for DefaultOrgMemberVisible"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; True will make the membership of the users visible when added to the organisation"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_ORG_MEMBER_VISIBLE = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default value for EnableDependencies"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Repositories will use dependencies by default depending on this setting"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_ENABLE_DEPENDENCIES = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Dependencies can be added from any repository where the user is granted access or only from the current repository depending on this setting."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ALLOW_CROSS_REPOSITORY_DEPENDENCIES = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default map service. No external API support has been included. A service has to allow"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; searching using URL parameters, the location will be appended to the URL as escaped query parameter."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Disabled by default, some example values are:"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - OpenStreetMap: https://www.openstreetmap.org/search?query="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - Google Maps: https://www.google.com/maps/place/"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - MapQuest: https://www.mapquest.com/search/"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - Bing Maps: https://www.bing.com/maps?where1="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT "; USER_LOCATION_MAP_URL ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enable heatmap on users profiles."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_USER_HEATMAP = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enable Timetracking"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_TIMETRACKING = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default value for EnableTimetracking"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Repositories will use timetracking by default depending on this setting"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_ENABLE_TIMETRACKING = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default value for AllowOnlyContributorsToTrackTime"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Only users with write permissions can track time if this is true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_ALLOW_ONLY_CONTRIBUTORS_TO_TRACK_TIME = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Value for the domain part of the user's email address in the git log if user"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; has set KeepEmailPrivate to true. The user's email will be replaced with a"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; concatenation of the user name in lower case, \"@\" and NO_REPLY_ADDRESS. Default"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; value is \"noreply.\" + DOMAIN, where DOMAIN resolves to the value from server.DOMAIN"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Note: do not use the <DOMAIN> notation below"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";NO_REPLY_ADDRESS = ; noreply.<DOMAIN>"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Show Registration button"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SHOW_REGISTRATION_BUTTON = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Show milestones dashboard page - a view of all the user's milestones"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SHOW_MILESTONES_DASHBOARD_PAGE = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default value for AutoWatchNewRepos"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; When adding a repo to a team or creating a new repo all team members will watch the"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; repo automatically if enabled"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";AUTO_WATCH_NEW_REPOS = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default value for AutoWatchOnChanges"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Make the user watch a repository When they commit for the first time"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";AUTO_WATCH_ON_CHANGES = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Minimum amount of time a user must exist before comments are kept when the user is deleted."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";USER_DELETE_WITH_COMMENTS_MAX_TIME = 0"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Valid site url schemes for user profiles"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";VALID_SITE_URL_SCHEMES=http,https"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[service.explore]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Only allow signed in users to view the explore pages."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REQUIRE_SIGNIN_VIEW = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Disable the users explore page."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DISABLE_USERS_PAGE = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Disable the organizations explore page."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DISABLE_ORGANIZATIONS_PAGE = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Disable the code explore page."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DISABLE_CODE_PAGE = false"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[qos]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enable request quality of service and overload protection."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT "; ENABLED = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The maximum number of concurrent requests that the server will"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; process before enqueueing new requests. Default is \"CpuNum * 4\"."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT "; MAX_INFLIGHT ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The maximum number of requests that can be enqueued before new"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; requests will be dropped."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT "; MAX_WAITING = 100"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Target maximum wait time a request may be enqueued for. Requests"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; that are enqueued for less than this amount of time will not be"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; dropped. When wait times exceed this amount, a portion of requests"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; will be dropped until wait times have decreased below this amount."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT "; TARGET_WAIT_TIME = 250ms"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Other Settings"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Uncomment the [section.header] if you wish to"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; set the below settings."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[repository]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Root path for storing all repository data. By default, it is set to \"{APP_DATA_PATH}/gitea-repositories\"."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; A relative path is interpreted as \"{AppWorkPath}/{ROOT}\" (use AppWorkPath as base path)."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ROOT ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The script type this server supports. Usually this is `bash`, but some users report that only `sh` is available."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SCRIPT_TYPE = bash"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; DETECTED_CHARSETS_ORDER tie-break order for detected charsets."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If the charsets have equal confidence, tie-breaking will be done by order in this list"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; with charsets earlier in the list chosen in preference to those later."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Adding \"defaults\" will place the unused charsets at that position."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DETECTED_CHARSETS_ORDER = UTF-8, UTF-16BE, UTF-16LE, UTF-32BE, UTF-32LE, ISO-8859, windows-1252, ISO-8859, windows-1250, ISO-8859, ISO-8859, ISO-8859, windows-1253, ISO-8859, windows-1255, ISO-8859, windows-1251, windows-1256, KOI8-R, ISO-8859, windows-1254, Shift_JIS, GB18030, EUC-JP, EUC-KR, Big5, ISO-2022, ISO-2022, ISO-2022, IBM424_rtl, IBM424_ltr, IBM420_rtl, IBM420_ltr"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default ANSI charset to override non-UTF-8 charsets to"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ANSI_CHARSET ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Force every new repository to be private"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";FORCE_PRIVATE = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default privacy setting when creating a new repository, allowed values: last, private, public. Default is last which means the last setting used."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_PRIVATE = last"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default private when using push-to-create"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_PUSH_CREATE_PRIVATE = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Global limit of repositories per user or org, applied at creation time. -1 means no limit"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; To configure independent limits for users and orgs, use USER_MAX_CREATION_LIMIT and ORG_MAX_CREATION_LIMIT"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MAX_CREATION_LIMIT = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Global limit of repositories per user, applied at creation time. -1 means no limit"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Takes precedence over MAX_CREATION_LIMIT when set"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";USER_MAX_CREATION_LIMIT = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Global limit of repositories per organization, applied at creation time. -1 means no limit"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Takes precedence over MAX_CREATION_LIMIT when set"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ORG_MAX_CREATION_LIMIT = -1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Preferred Licenses to place at the top of the List"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The name here must match the filename in options/license or custom/options/license"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PREFERRED_LICENSES = Apache License 2.0,MIT License"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Disable the ability to interact with repositories using the HTTP protocol"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DISABLE_HTTP_GIT = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Value for Access-Control-Allow-Origin header, default is not to present"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; WARNING: This may be harmful to your website if you do not give it a right value."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ACCESS_CONTROL_ALLOW_ORIGIN ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Force ssh:// clone url instead of scp-style uri when default SSH port is used"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";USE_COMPAT_SSH_URI = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Value for the \"go get\" request returns the repository url as https or ssh, default is https"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";GO_GET_CLONE_URL_PROTOCOL = https"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Close issues as long as a commit on any branch marks it as fixed"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_CLOSE_ISSUES_VIA_COMMITS_IN_ANY_BRANCH = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Allow users to push local repositories to Gitea and have them automatically created for a user or an org"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_PUSH_CREATE_USER = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_PUSH_CREATE_ORG = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Comma separated list of globally disabled repo units. Allowed values: repo.issues, repo.ext_issues, repo.pulls, repo.wiki, repo.ext_wiki, repo.projects, repo.packages, repo.actions."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DISABLED_REPO_UNITS ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Comma separated list of default new repo units. Allowed values: repo.code, repo.releases, repo.issues, repo.pulls, repo.wiki, repo.projects, repo.packages, repo.actions."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Note: Code and Releases can currently not be deactivated. If you specify default repo units you should still list them for future compatibility."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; External wiki and issue tracker can't be enabled by default as it requires additional settings."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Disabled repo units will not be added to new repositories regardless if it is in the default list."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_REPO_UNITS = repo.code,repo.releases,repo.issues,repo.pulls,repo.wiki,repo.projects,repo.packages,repo.actions"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Comma separated list of default forked repo units."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The set of allowed values and rules are the same as DEFAULT_REPO_UNITS."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_FORK_REPO_UNITS = repo.code,repo.pulls"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Comma separated list of default mirror repo units."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The set of allowed values and rules are the same as DEFAULT_REPO_UNITS."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_MIRROR_REPO_UNITS = repo.code,repo.releases,repo.issues,repo.wiki,repo.projects,repo.packages"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Comma separated list of default template repo units."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The set of allowed values and rules are the same as DEFAULT_REPO_UNITS."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_TEMPLATE_REPO_UNITS = repo.code,repo.releases,repo.issues,repo.pulls,repo.wiki,repo.projects,repo.packages"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Prefix archive files by placing them in a directory named after the repository"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PREFIX_ARCHIVE_FILES = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Disable migrating feature."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DISABLE_MIGRATIONS = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Disable stars feature."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DISABLE_STARS = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The default branch name of new repositories"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_BRANCH = main"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Allow adoption of unadopted repositories"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ALLOW_ADOPTION_OF_UNADOPTED_REPOSITORIES = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Allow deletion of unadopted repositories"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ALLOW_DELETION_OF_UNADOPTED_REPOSITORIES = false"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Don't allow download source archive files from UI"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DISABLE_DOWNLOAD_SOURCE_ARCHIVES = false"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Allow to fork repositories without maximum number limit"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ALLOW_FORK_WITHOUT_MAXIMUM_LIMIT = true"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Allow to fork repositories into the same owner (user or organization)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; This feature is experimental, not fully tested, and may be changed in the future"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ALLOW_FORK_INTO_SAME_OWNER = false"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[repository.editor]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; List of file extensions for which lines should be wrapped in the Monaco editor"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Separate extensions with a comma. To line wrap files without an extension, just put a comma"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LINE_WRAP_EXTENSIONS = .txt,.md,.markdown,.mdown,.mkd,.livemd,"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[repository.upload]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Whether repository file uploads are enabled. Defaults to `true`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Comma-separated list of allowed file extensions (`.zip`), mime types (`text/plain`) or wildcard type (`image/*`, `audio/*`, `video/*`). Empty value or `*/*` allows all types."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ALLOWED_TYPES ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Max size of each file in megabytes. Defaults to 50MB"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";FILE_MAX_SIZE = 50"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Max number of files per upload. Defaults to 5"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MAX_FILES = 5"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[repository.pull-request]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; List of prefixes used in Pull Request title to mark them as Work In Progress (matched in a case-insensitive manner)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";WORK_IN_PROGRESS_PREFIXES = WIP:,[WIP]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; List of keywords used in Pull Request comments to automatically close a related issue"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";CLOSE_KEYWORDS = close,closes,closed,fix,fixes,fixed,resolve,resolves,resolved"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; List of keywords used in Pull Request comments to automatically reopen a related issue"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REOPEN_KEYWORDS = reopen,reopens,reopened"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Set default merge style for repository creating, valid options: merge, rebase, rebase-merge, squash, fast-forward-only"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_MERGE_STYLE = merge"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; In the default merge message for squash commits include at most this many commits"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_MERGE_MESSAGE_COMMITS_LIMIT = 50"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; In the default merge message for squash commits limit the size of the commit messages to this"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_MERGE_MESSAGE_SIZE = 5120"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; In the default merge message for squash commits walk all commits to include all authors in the Co-authored-by otherwise just use those in the limited list"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_MERGE_MESSAGE_ALL_AUTHORS = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; In default merge messages limit the number of approvers listed as Reviewed-by: to this many"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_MERGE_MESSAGE_MAX_APPROVERS = 10"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; In default merge messages only include approvers who are official"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_MERGE_MESSAGE_OFFICIAL_APPROVERS_ONLY = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; In default squash-merge messages include the commit message of all commits comprising the pull request."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";POPULATE_SQUASH_COMMENT_WITH_COMMIT_MESSAGES = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Add co-authored-by and co-committed-by trailers if committer does not match author"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ADD_CO_COMMITTER_TRAILERS = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Retarget child pull requests to the parent pull request branch target on merge of parent pull request. It only works on merged PRs where the head and base branch target the same repo."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RETARGET_CHILDREN_ON_MERGE = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default source for the pull request title when opening a new PR."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; \"first-commit\" uses the oldest commit's summary."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; \"auto\" uses commit's summary if the PR only has one commit, normalizes the branch name if multiple commits."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_TITLE_SOURCE = auto"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Delay mergeable check until page view or API access, for pull requests that have not been updated in the specified days when their base branches get updated."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Use \"-1\" to always check all pull requests (old behavior). Use \"0\" to always delay the checks."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DELAY_CHECK_FOR_INACTIVE_DAYS = 7"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Set the default value for \"Delete pull request branch after merge by default\" for new repositories"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_DELETE_BRANCH_AFTER_MERGE = false"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[repository.issue]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; List of reasons why a Pull Request or Issue can be locked"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LOCK_REASONS = Too heated,Off-topic,Resolved,Spam"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum number of pinned Issues per repo"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Set to 0 to disable pinning Issues"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MAX_PINNED = 3"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[repository.release]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Comma-separated list of allowed release attachment file extensions (`.zip`), mime types (`text/plain`) or wildcard type (`image/*`, `audio/*`, `video/*`). Empty value or `*/*` allows all types."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ALLOWED_TYPES ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Number of releases that are displayed on release page"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_PAGING_NUM = 10"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Max size of each release attachment file in megabytes. Defaults to 2GB"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";FILE_MAX_SIZE = 2048"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Max number of release attachment files per upload. Defaults to 5"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MAX_FILES =  5"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[repository.signing]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; GPG or SSH key to use to sign commits, Defaults to the default - that is the value of git config --get user.signingkey"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Depending on the value of SIGNING_FORMAT this is either:"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - openpgp: the GPG key ID"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - ssh: the path to the ssh public key \"/path/to/key.pub\": where \"/path/to/key\" is the private key, use ssh-keygen -t ed25519 to generate a new key pair without password"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; run in the context of the RUN_USER"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Switch to none to stop signing completely"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SIGNING_KEY = default"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If a SIGNING_KEY ID is provided and is not set to default, use the provided Name and Email address as the signer and the signing format."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; These should match a publicized name and email address for the key. (When SIGNING_KEY is default these are set to"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; the results of git config --get user.name, git config --get user.email and git config --default openpgp --get gpg.format respectively and can only be overridden"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; by setting the SIGNING_KEY ID to the correct ID.)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SIGNING_NAME ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SIGNING_EMAIL ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; SIGNING_FORMAT can be one of:"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - openpgp (default): use GPG to sign commits"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - ssh: use SSH to sign commits"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SIGNING_FORMAT = openpgp"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Sets the default trust model for repositories. Options are: collaborator, committer, collaboratorcommitter"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_TRUST_MODEL = collaborator"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Determines when gitea should sign the initial commit when creating a repository"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Either:"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - never"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - pubkey: only sign if the user has a pubkey"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - twofa: only sign if the user has logged in with twofa"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - always"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; options other than none and always can be combined as comma separated list"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";INITIAL_COMMIT = always"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Determines when to sign for CRUD actions"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - as above"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - parentsigned: requires that the parent commit is signed."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";CRUD_ACTIONS = pubkey, twofa, parentsigned"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Determines when to sign Wiki commits"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - as above"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";WIKI = never"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Determines when to sign on merges"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - basesigned: require that the parent of commit on the base repo is signed."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - commitssigned: require that all the commits in the head branch are signed."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - approved: only sign when merging an approved pr to a protected branch"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MERGES = pubkey, twofa, basesigned, commitssigned"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Determines which additional ssh keys are trusted for all signed commits regardless of the user"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; This is useful for ssh signing key rotation."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Exposes the provided SIGNING_NAME and SIGNING_EMAIL as the signer, regardless of the SIGNING_FORMAT value."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Multiple keys should be comma separated."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; E.g.\"ssh-<algorithm> <key>\". or \"ssh-<algorithm> <key1>, ssh-<algorithm> <key2>\"."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";TRUSTED_SSH_KEYS ="
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[repository.mimetype_mapping]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Custom MIME type mapping for downloadable files"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";.apk=application/vnd.android.package-archive"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[project]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default templates for project boards"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PROJECT_BOARD_BASIC_KANBAN_TYPE = To Do, In Progress, Done"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PROJECT_BOARD_BUG_TRIAGE_TYPE = Needs Triage, High Priority, Low Priority, Closed"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[cors]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; More information about CORS can be found here: https://developer.mozilla.org/en-US/docs/Web/HTTP/CORS#The_HTTP_response_headers"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; enable cors headers (disabled by default)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; list of requesting origins that are allowed, eg: \"https://*.example.com\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ALLOW_DOMAIN = *"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; list of methods allowed to request"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";METHODS = GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; max time to cache response"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MAX_AGE = 10m"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; allow request with credentials"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ALLOW_CREDENTIALS = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; headers to permit"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";HEADERS = Content-Type,User-Agent"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[ui]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Number of repositories that are displayed on one explore page"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";EXPLORE_PAGING_NUM = 20"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Number of issues that are displayed on one page"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ISSUE_PAGING_NUM = 20"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Number of maximum commits displayed in one activity feed"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";FEED_MAX_COMMIT_NUM = 5"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Number of items that are displayed in home feed"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";FEED_PAGING_NUM = 20"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Number of items that are displayed in a single subsitemap"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SITEMAP_PAGING_NUM = 20"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Number of maximum commits displayed in commit graph."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";GRAPH_MAX_COMMIT_NUM = 100"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Number of line of codes shown for a code comment"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";CODE_COMMENT_LINES = 4"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Max size of files to be displayed (default is 8MiB)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MAX_DISPLAY_FILE_SIZE = 8388608"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Detect ambiguous unicode characters in file contents and show warnings on the UI"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";AMBIGUOUS_UNICODE_DETECTION = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Whether the email of the user should be shown in the Explore Users page"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SHOW_USER_EMAIL = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Set the default theme for the Gitea install"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_THEME = gitea-auto"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; All available themes. Allow users select personalized themes regardless of the value of `DEFAULT_THEME`."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Leave it empty to allow users to select any theme from \"{CustomPath}/public/assets/css/theme-*.css\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";THEMES ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The icon theme for files (basic/material)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";FILE_ICON_THEME = material"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The icon theme for folders (basic/material)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";FOLDER_ICON_THEME = basic"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; All available reactions users can choose on issues/prs and comments."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Values can be emoji alias (:smile:) or a unicode emoji."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; For custom reactions, add a tightly cropped square image to public/assets/img/emoji/reaction_name.png"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REACTIONS = +1, -1, laugh, hooray, confused, heart, rocket, eyes"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Change the number of users that are displayed in reactions tooltip (triggered by mouse hover)."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REACTION_MAX_USER_NUM = 10"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Additional Emojis not defined in the utf8 standard"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; By default we support gitea (:gitea:), to add more copy them to public/assets/img/emoji/emoji_name.png and add it to this config."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Dont mistake it for Reactions."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";CUSTOM_EMOJIS = gitea, codeberg, gitlab, git, github, gogs"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Comma separated list of enabled emojis, for example: smile, thumbsup, thumbsdown"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Leave it empty to enable all emojis."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED_EMOJIS ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Whether the full name of the users should be shown where possible. If the full name isn't set, the username will be used."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_SHOW_FULL_NAME = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Whether to search within description at repository search on explore page."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SEARCH_REPO_DESCRIPTION = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Whether to only show relevant repos on the explore page when no keyword is specified and default sorting is used."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; A repo is considered irrelevant if it's a fork or if it has no metadata (no description, no icon, no topic)."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ONLY_SHOW_RELEVANT_REPOS = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Change the sort type of the explore pages."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default is \"recentupdate\", but you also have \"alphabetically\", \"reverselastlogin\", \"newest\", \"oldest\"."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";EXPLORE_PAGING_DEFAULT_SORT = recentupdate"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The tense all timestamps should be rendered in. Possible values are `absolute` time (i.e. 1970-01-01, 11:59) and `mixed`."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; `mixed` means most timestamps are rendered in relative time (i.e. 2 days ago)."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PREFERRED_TIMESTAMP_TENSE = mixed"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[ui.admin]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Number of users that are displayed on one page"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";USER_PAGING_NUM = 50"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Number of repos that are displayed on one page"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REPO_PAGING_NUM = 50"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Number of notices that are displayed on one page"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";NOTICE_PAGING_NUM = 25"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Number of organizations that are displayed on one page"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ORG_PAGING_NUM = 50"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[ui.user]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Number of repos that are displayed on one page"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REPO_PAGING_NUM = 15"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Number of orgs that are displayed on profile page"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ORG_PAGING_NUM = 15"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[ui.meta]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";AUTHOR = Gitea - Git with a cup of tea"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DESCRIPTION = Gitea (Git with a cup of tea) is a painless self-hosted Git service written in Go"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";KEYWORDS = go,git,self-hosted,gitea"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[ui.notification]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Control how often the notification endpoint is polled to update the notification"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The timeout will increase to MAX_TIMEOUT in TIMEOUT_STEPs if the notification count is unchanged"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Set MIN_TIMEOUT to -1 to turn off"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MIN_TIMEOUT = 10s"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MAX_TIMEOUT = 60s"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";TIMEOUT_STEP = 10s"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; This setting determines how often the db is queried to get the latest notification counts."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If the browser client supports EventSource and SharedWorker, a SharedWorker will be used in preference to polling notification. Set to -1 to disable the EventSource"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";EVENT_SOURCE_UPDATE_TIME = 10s"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[ui.svg]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Whether to render SVG files as images.  If SVG rendering is disabled, SVG files are displayed as text and cannot be embedded in markdown files as images."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_RENDER = true"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[ui.csv]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum allowed file size in bytes to render CSV files as table. (Set to 0 for no limit)."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MAX_FILE_SIZE = 524288"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum allowed rows to render CSV files. (Set to 0 for no limit)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MAX_ROWS = 2500"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[markdown]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Customize render options for different contexts. Set to \"none\" to disable the defaults, or use comma separated list:"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; * short-issue-pattern: recognized \"#123\" issue reference and render it as a link to the issue"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; * new-line-hard-break: render soft line breaks as hard line breaks, which means a single newline character between"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;   paragraphs will cause a line break and adding trailing whitespace to paragraphs is not"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;   necessary to force a line break."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RENDER_OPTIONS_COMMENT = short-issue-pattern, new-line-hard-break"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RENDER_OPTIONS_WIKI = short-issue-pattern"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RENDER_OPTIONS_REPO_FILE ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Comma separated list of custom URL-Schemes that are allowed as links when rendering Markdown"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; for example git,magnet,ftp (more at https://en.wikipedia.org/wiki/List_of_URI_schemes)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; URLs starting with http and https are always displayed, whatever is put in this entry."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If this entry is empty, all URL schemes are allowed."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";CUSTOM_URL_SCHEMES ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; List of file extensions that should be rendered/edited as Markdown"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Separate the extensions with a comma. To render files without any extension as markdown, just put a comma"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";FILE_EXTENSIONS = .md,.markdown,.mdown,.mkd,.livemd"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enables math inline and block detection"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_MATH = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enable delimiters for math code block detection. Set to \"none\" to disable all,"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; or use comma separated list: inline-dollar, inline-parentheses, block-dollar, block-square-brackets"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Defaults to \"inline-dollar,block-dollar\" to follow GitHub's behavior."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MATH_CODE_BLOCK_DETECTION ="
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[ssh.minimum_key_sizes]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Define allowed algorithms and their minimum key length (use -1 to disable a type)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ED25519 = 256"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ECDSA = 256"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RSA = 3071 ; we allow 3071 here because an otherwise valid 3072 bit RSA key can be reported as having 3071 bit length"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DSA = -1 ; set to 1024 to switch on"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[indexer]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Issue Indexer settings"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Issue indexer type, currently support: bleve, db, elasticsearch (also compatible with OpenSearch) or meilisearch default is bleve"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ISSUE_INDEXER_TYPE = bleve"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Issue indexer storage path, available when ISSUE_INDEXER_TYPE is bleve"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ISSUE_INDEXER_PATH = indexers/issues.bleve ; Relative paths will be made absolute against _`AppWorkPath`_."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Issue indexer connection string, available when ISSUE_INDEXER_TYPE is elasticsearch (e.g. http://elastic:password@localhost:9200) or meilisearch (e.g. http://:apikey@localhost:7700)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ISSUE_INDEXER_CONN_STR ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Issue indexer name, available when ISSUE_INDEXER_TYPE is elasticsearch or meilisearch."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ISSUE_INDEXER_NAME = gitea_issues"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Timeout the indexer if it takes longer than this to start."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Set to -1 to disable timeout."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";STARTUP_TIMEOUT = 30s"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Repository Indexer settings"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; repo indexer by default disabled, since it uses a lot of disk space"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REPO_INDEXER_ENABLED = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; repo indexer units, the items to index, could be `sources`, `forks`, `mirrors`, `templates` or any combination of them separated by a comma."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If empty then it defaults to `sources` only, as if you'd like to disable fully please see REPO_INDEXER_ENABLED."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REPO_INDEXER_REPO_TYPES = sources,forks,mirrors,templates"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Code search engine type, could be `bleve` or `elasticsearch` (also compatible with OpenSearch)."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REPO_INDEXER_TYPE = bleve"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Index file used for code search. available when `REPO_INDEXER_TYPE` is bleve"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REPO_INDEXER_PATH = indexers/repos.bleve"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Code indexer connection string, available when `REPO_INDEXER_TYPE` is elasticsearch. i.e. http://elastic:changeme@localhost:9200"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REPO_INDEXER_CONN_STR ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Code indexer name, available when `REPO_INDEXER_TYPE` is elasticsearch"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REPO_INDEXER_NAME = gitea_codes"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; A comma separated list of glob patterns (see https://github.com/gobwas/glob) to include"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; in the index; default is empty"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REPO_INDEXER_INCLUDE ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; A comma separated list of glob patterns to exclude from the index; ; default is empty"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REPO_INDEXER_EXCLUDE ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MAX_FILE_SIZE = 1048576"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Bleve engine has performance problems with fuzzy search, so we limit the fuzziness to 0 by default to disable it."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If you'd like to enable it, you can set it to a value between 0 and 2."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";TYPE_BLEVE_MAX_FUZZINESS = 0"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[queue]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Specific queues can be individually configured with [queue.name]. [queue] provides defaults"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; ([queue.issue_indexer] is special due to the old configuration described above)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; General queue queue type, currently support: persistable-channel, channel, level, redis, dummy"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; default to persistable-channel"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";TYPE = persistable-channel"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; data-dir for storing persistable queues and level queues, individual queues will default to `queues/common` meaning the queue is shared."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Relative paths will be made absolute against \"APP_DATA_PATH\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DATADIR = queues/"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default queue length before a channel queue will block"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";LENGTH = 100000"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Batch size to send for batched queues"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";BATCH_LENGTH = 20"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Connection string for redis queues this will store the redis (or Redis cluster) connection string."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; When `TYPE` is `persistable-channel`, this provides a directory for the underlying leveldb"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; or additional options of the form `leveldb://path/to/db?option=value&....`, and will override `DATADIR`."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";CONN_STR = \"redis://127.0.0.1:6379/0\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Provides the suffix of the default redis/disk queue name - specific queues can be overridden within in their [queue.name] sections."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";QUEUE_NAME = \"_queue\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Provides the suffix of the default redis/disk unique queue set name - specific queues can be overridden within in their [queue.name] sections."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SET_NAME = \"_unique\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum number of worker go-routines for the queue. Default value is \"CpuNum/2\" clipped to between 1 and 10."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MAX_WORKERS = ; (dynamic)"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[admin]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Disallow regular (non-admin) users from creating organizations."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DISABLE_REGULAR_ORG_CREATION = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default configuration for email notifications for users (user configurable). Options: enabled, onmention, disabled"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_EMAIL_NOTIFICATIONS = enabled"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Disabled features for users could be \"deletion\", \"manage_ssh_keys\", \"manage_gpg_keys\", \"manage_mfa\", \"manage_credentials\" more features can be disabled in future"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - deletion: a user cannot delete their own account"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - manage_ssh_keys: a user cannot configure ssh keys"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - manage_gpg_keys: a user cannot configure gpg keys"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - manage_mfa: a user cannot configure mfa devices"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - manage_credentials: a user cannot configure emails, passwords, or openid"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";USER_DISABLED_FEATURES ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Comma separated list of disabled features ONLY if the user has an external login type (eg. LDAP, Oauth, etc.), could be \"deletion\", \"manage_ssh_keys\", \"manage_gpg_keys\", \"manage_mfa\", \"manage_credentials\". This setting is independent from `USER_DISABLED_FEATURES` and supplements its behavior."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - deletion: a user cannot delete their own account"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - manage_ssh_keys: a user cannot configure ssh keys"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - manage_gpg_keys: a user cannot configure gpg keys"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - manage_mfa: a user cannot configure mfa devices"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - manage_credentials: a user cannot configure emails, passwords, or openid"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - change_username: a user cannot change their username"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - change_full_name: a user cannot change their full name"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;EXTERNAL_USER_DISABLE_FEATURES ="
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[openid]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; OpenID is an open, standard and decentralized authentication protocol."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Your identity is the address of a webpage you provide, which describes"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; how to prove you are in control of that page."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; For more info: https://en.wikipedia.org/wiki/OpenID"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Current implementation supports OpenID-2.0"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Tested to work providers at the time of writing:"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;  - Any GNUSocial node (your.hostname.tld/username)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;  - Any SimpleID provider (http://simpleid.koinic.net)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;  - http://openid.org.cn/"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;  - openid.stackexchange.com"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;  - login.launchpad.net"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;  - <username>.livejournal.com"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Whether to allow signin in via OpenID"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_OPENID_SIGNIN = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Whether to allow registering via OpenID"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Do not include to rely on rhw DISABLE_REGISTRATION setting"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;ENABLE_OPENID_SIGNUP = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Allowed URI patterns (POSIX regexp)."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Space separated."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Only these would be allowed if non-blank."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Example value: trusted.domain.org trusted.domain.net"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";WHITELISTED_URIS ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Forbidden URI patterns (POSIX regexp)."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Space separated."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Only used if WHITELISTED_URIS is blank."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Example value: loadaverage.org/badguy stackexchange.com/.*spammer"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";BLACKLISTED_URIS ="
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[oauth2_client]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Whether a new auto registered oauth2 user needs to confirm their email."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Do not include to use the REGISTER_EMAIL_CONFIRM setting from the `[service]` section."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REGISTER_EMAIL_CONFIRM ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Scopes for the openid connect oauth2 provider (separated by space, the openid scope is implicitly added)."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Typical values are profile and email."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; For more information about the possible values see https://openid.net/specs/openid-connect-core-1_0.html#ScopeClaims"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";OPENID_CONNECT_SCOPES ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Automatically create user accounts for new oauth2 users."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_AUTO_REGISTRATION = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The source of the username for new oauth2 accounts:"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; userid = use the userid / sub attribute"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; nickname = use the nickname attribute"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; preferred_username = use the preferred_username attribute"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; email = use the username part of the email attribute"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Note: `nickname`, `preferred_username` and `email` options will normalize input strings using the following criteria:"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - diacritics are removed"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - the characters in the set ['´`] are removed"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - the characters in the set [\\s~+] are replaced with \"-\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";USERNAME = nickname"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Update avatar if available from oauth2 provider."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Update will be performed on each login."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";UPDATE_AVATAR = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; How to handle if an account / email already exists:"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; disabled = show an error"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; login = show an account linking login"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; auto = link directly with the account"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ACCOUNT_LINKING = login"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[webhook]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Hook task queue length, increase if webhook shooting starts hanging"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";QUEUE_LENGTH = 1000"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Deliver timeout in seconds"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DELIVER_TIMEOUT = 5"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Webhook can only call allowed hosts for security reasons. Comma separated list, eg: external, 192.168.1.0/24, *.mydomain.com"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Built-in: loopback (for localhost), private (for LAN/intranet), external (for public hosts on internet), * (for all hosts)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; CIDR list: 1.2.3.0/8, 2001:db8::/32"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Wildcard hosts: *.mydomain.com, 192.168.100.*"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Since 1.15.7. Default to * for 1.15.x, external for 1.16 and later"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ALLOWED_HOST_LIST = external"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Allow insecure certification"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SKIP_TLS_VERIFY = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Number of history information in each page"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PAGING_NUM = 10"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Proxy server URL, support http://, https//, socks://, blank will follow environment http_proxy/https_proxy"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PROXY_URL ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Comma separated list of host names requiring proxy. Glob patterns (*) are accepted; use ** to match all hosts."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PROXY_HOSTS ="
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[mailer]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; NOTICE: this section is for Gitea 1.18 and later. If you are using Gitea 1.17 or older,"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; please refer to"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; https://github.com/go-gitea/gitea/blob/release/v1.17/custom/conf/app.example.ini"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; https://github.com/go-gitea/gitea/blob/release/v1.17/docs/content/doc/advanced/config-cheat-sheet.en-us.md"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Buffer length of channel, keep it as it is if you don't know what it is."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SEND_BUFFER_LEN = 100"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Prefix displayed before subject in mail"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SUBJECT_PREFIX ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Mail server protocol. One of \"smtp\", \"smtps\", \"smtp+starttls\", \"smtp+unix\", \"sendmail\", \"dummy\"."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - sendmail: use the operating system's `sendmail` command instead of SMTP. This is common on Linux systems."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; - dummy: send email messages to the log as a testing phase."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If your provider does not explicitly say which protocol it uses but does provide a port,"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; you can set SMTP_PORT instead and this will be inferred."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; (Before 1.18, see the notice, this was controlled via MAILER_TYPE and IS_TLS_ENABLED.)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PROTOCOL ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Mail server address, e.g. smtp.gmail.com."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; For smtp+unix, this should be a path to a unix socket instead."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; (Before 1.18, see the notice, this was combined with SMTP_PORT as HOST.)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SMTP_ADDR ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Mail server port. Common ports are:"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;   25:  insecure SMTP"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;   465: SMTP Secure"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;   587: StartTLS"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If no protocol is specified, it will be inferred by this setting."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; (Before 1.18, this was combined with SMTP_ADDR as HOST.)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SMTP_PORT ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enable HELO operation. Defaults to true."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_HELO = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Custom hostname for HELO operation."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If no value is provided, one is retrieved from system."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";HELO_HOSTNAME ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If set to `true`, completely ignores server certificate validation errors."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; This option is unsafe. Consider adding the certificate to the system trust store instead."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";FORCE_TRUST_SERVER_CERT = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Use client certificate in connection."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";USE_CLIENT_CERT = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";CLIENT_CERT_FILE = custom/mailer/cert.pem"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";CLIENT_KEY_FILE = custom/mailer/key.pem"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Mail from address, RFC 5322. This can be just an email address, or the `\"Name\" <email@example.com>` format"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";FROM ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Sometimes it is helpful to use a different address on the envelope. Set this to use ENVELOPE_FROM as the from on the envelope. Set to `<>` to send an empty address."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENVELOPE_FROM ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If gitea sends mails on behave of users, it will just use the name also displayed in the WebUI. If you want e.g. `Mister X (by CodeIt) <gitea@codeit.net>`,"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; set it to `{{ .DisplayName }} (by {{ .AppName }})`. Available Variables: `.DisplayName`, `.AppName` and `.Domain`."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";FROM_DISPLAY_NAME_FORMAT = {{ .DisplayName }}"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Mailer user name and password, if required by provider."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";USER ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Use PASSWD = `your password` for quoting if you use special characters in the password."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PASSWD ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Send mails only in plain text, without HTML alternative"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SEND_AS_PLAIN_TEXT = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Specify an alternative sendmail binary"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SENDMAIL_PATH = sendmail"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Specify any extra sendmail arguments"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; WARNING: if your sendmail program interprets options you should set this to \"--\" or terminate these args with \"--\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SENDMAIL_ARGS ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Timeout for Sendmail"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SENDMAIL_TIMEOUT = 5m"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; convert \\r\\n to \\n for Sendmail"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SENDMAIL_CONVERT_CRLF = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; convert links of attached images to inline images. Only for images hosted in this gitea instance."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";EMBED_ATTACHMENT_IMAGES = false"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[mailer.override_header]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; This is empty by default, use it only if you know what you need it for."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";Reply-To = test@example.com, test2@example.com"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";Content-Type = text/html; charset=utf-8"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";In-Reply-To ="
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[email.incoming]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enable handling of incoming emails."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The email address including the %{token} placeholder that will be replaced per user/action."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Example: incoming+%{token}@example.com"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The placeholder must appear in the user part of the address (before the @)."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REPLY_TO_ADDRESS ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; IMAP server host"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";HOST ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; IMAP server port"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PORT ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Username of the receiving account"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";USERNAME ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Password of the receiving account"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PASSWORD ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Whether the IMAP server uses TLS."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";USE_TLS = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If set to true, completely ignores server certificate validation errors. This option is unsafe."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SKIP_TLS_VERIFY = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The mailbox name where incoming mail will end up."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MAILBOX = INBOX"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Whether handled messages should be deleted from the mailbox."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DELETE_HANDLED_MESSAGE = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum size of a message to handle. Bigger messages are ignored. Set to 0 to allow every size."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MAXIMUM_MESSAGE_SIZE = 10485760"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[cache]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Either \"memory\", \"redis\", \"memcache\", or \"twoqueue\". default is \"memory\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ADAPTER = memory"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; For \"memory\" only, GC interval in seconds, default is 60"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";INTERVAL = 60"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; For \"redis\" and \"memcache\", connection host address"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; redis: `redis://127.0.0.1:6379/0?pool_size=100&idle_timeout=180s` (or `redis+cluster://127.0.0.1:6379/0?pool_size=100&idle_timeout=180s` for a Redis cluster)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; memcache: `127.0.0.1:11211`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; twoqueue: `{\"size\":50000,\"recent_ratio\":0.25,\"ghost_ratio\":0.5}` or `50000`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";HOST ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Time to keep items in cache if not used, default is 16 hours."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Setting it to -1 disables caching"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ITEM_TTL = 16h"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Last commit cache"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[cache.last_commit]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Time to keep items in cache if not used, default is 8760 hours."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Setting it to -1 disables caching"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ITEM_TTL = 8760h"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Only enable the cache when repository's commits count great than"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";COMMITS_COUNT = 1000"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[session]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Either \"memory\", \"file\", \"redis\", \"db\", \"mysql\", \"couchbase\", \"memcache\" or \"postgres\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Default is \"memory\". \"db\" will reuse the configuration in [database]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PROVIDER = memory"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Provider config options"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; memory: doesn't have any config yet"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; file: session file path, e.g. `data/sessions`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; redis: `redis://127.0.0.1:6379/0?pool_size=100&idle_timeout=180s` (or `redis+cluster://127.0.0.1:6379/0?pool_size=100&idle_timeout=180s` for a Redis cluster)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; mysql: go-sql-driver/mysql dsn config string, e.g. `root:password@/session_table`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PROVIDER_CONFIG = data/sessions ; Relative paths will be made absolute against _`AppWorkPath`_."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Session cookie name"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";COOKIE_NAME = i_like_gitea"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If you use session in https only: true or false. If not set, it defaults to `true` if the ROOT_URL is an HTTPS URL."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";COOKIE_SECURE ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Session GC time interval in seconds, default is 86400 (1 day)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";GC_INTERVAL_TIME = 86400"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Session life time in seconds, default is 86400 (1 day)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SESSION_LIFE_TIME = 86400"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; SameSite settings. Either \"none\", \"lax\", or \"strict\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SAME_SITE=lax"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[picture]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";AVATAR_UPLOAD_PATH = data/avatars"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REPOSITORY_AVATAR_UPLOAD_PATH = data/repo-avatars"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; How Gitea deals with missing repository avatars"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; none = no avatar will be displayed; random = random avatar will be displayed; image = default image will be used"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REPOSITORY_AVATAR_FALLBACK = none"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";REPOSITORY_AVATAR_FALLBACK_IMAGE = /img/repo_default.png"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Max Width and Height of uploaded avatars."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; This is to limit the amount of RAM used when resizing the image."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";AVATAR_MAX_WIDTH = 4096"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";AVATAR_MAX_HEIGHT = 4096"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; The multiplication factor for rendered avatar images."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Larger values result in finer rendering on HiDPI devices."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";AVATAR_RENDERED_SIZE_FACTOR = 2"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Maximum allowed file size for uploaded avatars."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; This is to limit the amount of RAM used when resizing the image."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";AVATAR_MAX_FILE_SIZE = 1048576"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If the uploaded file is not larger than this byte size, the image will be used as is, without resizing/converting."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";AVATAR_MAX_ORIGIN_SIZE = 262144"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Chinese users can choose \"duoshuo\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; or a custom avatar source, like: http://cn.gravatar.com/avatar/"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";GRAVATAR_SOURCE = gravatar"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Deprecated, see Web UI Admin Panel -> Config -> Settings"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DISABLE_GRAVATAR = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Federated avatar lookup uses DNS to discover avatar associated"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; with emails, see https://www.libravatar.org"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Deprecated, see Web UI Admin Panel -> Config -> Settings"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLE_FEDERATED_AVATAR = false"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[attachment]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Whether issue, pull-request and release attachments are enabled. Defaults to `true`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; ALLOWED_TYPES/MAX_SIZE/MAX_FILES in this section only affect issue and pull-request attachments, not release attachments."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Release attachment has its own config options in [repository.release] section."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Comma-separated list of allowed issue/pull-request attachment file extensions (`.zip`), mime types (`text/plain`) or wildcard type (`image/*`, `audio/*`, `video/*`). Empty value or `*/*` allows all types."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ALLOWED_TYPES = .avif,.cpuprofile,.csv,.dmp,.docx,.fodg,.fodp,.fods,.fodt,.gif,.gz,.jpeg,.jpg,.json,.jsonc,.log,.md,.mov,.mp4,.odf,.odg,.odp,.ods,.odt,.patch,.pdf,.png,.pptx,.svg,.tgz,.txt,.webm,.webp,.xls,.xlsx,.zip"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Max size of each issue/pull-request attachment file. Defaults to 100MB"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MAX_SIZE = 100"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Max number of issue/pull-request attachment files per upload. Defaults to 5"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MAX_FILES = 5"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Storage type for attachments, `local` for local disk or `minio` for s3 compatible"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; object storage service, default is `local`."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";STORAGE_TYPE = local"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Allows the storage driver to redirect to authenticated URLs to serve files directly"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Currently, only `minio` and `azureblob` is supported."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SERVE_DIRECT = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Path for attachments. Defaults to `attachments`. Only available when STORAGE_TYPE is `local`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Relative paths will be resolved to `${AppDataPath}/${attachment.PATH}`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PATH = attachments"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Minio endpoint to connect only available when STORAGE_TYPE is `minio`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MINIO_ENDPOINT = localhost:9000"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Minio accessKeyID to connect only available when STORAGE_TYPE is `minio`."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If not provided and STORAGE_TYPE is `minio`, will search for credentials in known"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; environment variables (MINIO_ACCESS_KEY_ID, AWS_ACCESS_KEY_ID), credentials files"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; (~/.mc/config.json, ~/.aws/credentials), and EC2 instance metadata."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MINIO_ACCESS_KEY_ID ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Minio secretAccessKey to connect only available when STORAGE_TYPE is `minio`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MINIO_SECRET_ACCESS_KEY ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Preferred IAM Endpoint to override Minio's default IAM Endpoint resolution only available when STORAGE_TYPE is `minio`."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; If not provided and STORAGE_TYPE is `minio`, will search for and derive endpoint from known environment variables"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; (AWS_CONTAINER_AUTHORIZATION_TOKEN, AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE, AWS_CONTAINER_CREDENTIALS_RELATIVE_URI,"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; AWS_CONTAINER_CREDENTIALS_FULL_URI, AWS_WEB_IDENTITY_TOKEN_FILE, AWS_ROLE_ARN, AWS_ROLE_SESSION_NAME, AWS_REGION),"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; or the DefaultIAMRoleEndpoint if not provided otherwise."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MINIO_IAM_ENDPOINT ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Minio bucket to store the attachments only available when STORAGE_TYPE is `minio`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MINIO_BUCKET = gitea"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Minio location to create bucket only available when STORAGE_TYPE is `minio`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MINIO_LOCATION = us-east-1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Minio base path on the bucket only available when STORAGE_TYPE is `minio`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MINIO_BASE_PATH = attachments/"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Minio enabled ssl only available when STORAGE_TYPE is `minio`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MINIO_USE_SSL = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Minio skip SSL verification available when STORAGE_TYPE is `minio`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MINIO_INSECURE_SKIP_VERIFY = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Minio checksum algorithm: default (for MinIO or AWS S3) or md5 (for Cloudflare or Backblaze)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MINIO_CHECKSUM_ALGORITHM = default"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Minio bucket lookup method defaults to auto mode; set it to `dns` for virtual host style or `path` for path style, only available when STORAGE_TYPE is `minio`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";MINIO_BUCKET_LOOKUP_TYPE = auto"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Azure Blob endpoint to connect only available when STORAGE_TYPE is `azureblob`,"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; e.g. https://accountname.blob.core.windows.net or http://127.0.0.1:10000/devstoreaccount1"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";AZURE_BLOB_ENDPOINT ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Azure Blob account name to connect only available when STORAGE_TYPE is `azureblob`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";AZURE_BLOB_ACCOUNT_NAME ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Azure Blob account key to connect only available when STORAGE_TYPE is `azureblob`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";AZURE_BLOB_ACCOUNT_KEY ="
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Azure Blob container to store the attachments only available when STORAGE_TYPE is `azureblob`"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";AZURE_BLOB_CONTAINER = gitea"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; override the azure blob base path if storage type is azureblob"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";AZURE_BLOB_BASE_PATH = attachments/"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[time]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Location the UI time display i.e. Asia/Shanghai"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Empty means server's location setting"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";DEFAULT_UI_LOCATION ="
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[cron]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Common settings"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Setting this to true will enable all cron tasks periodically with default settings."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Setting this to true will run all enabled cron tasks when Gitea starts."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RUN_AT_START = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Note: ``SCHEDULE`` accept formats"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;    - Full crontab specs, e.g. \"* * * * * ?\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;    - Descriptors, e.g. \"@midnight\", \"@every 1h30m\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; See more: https://pkg.go.dev/github.com/gogs/cron@v0.0.0-20171120032916-9f6c956d3e14"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Basic cron tasks - enabled by default"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Clean up old repository archives"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[cron.archive_cleanup]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Whether to enable the job"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Whether to always run at least once at start up time (if ENABLED)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RUN_AT_START = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Whether to emit notice on successful execution too"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";NOTICE_ON_SUCCESS = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Time interval for job to run"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SCHEDULE = @midnight"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Archives created more than OLDER_THAN ago are subject to deletion"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";OLDER_THAN = 24h"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Update mirrors"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[cron.update_mirrors]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SCHEDULE = @every 10m"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enable running Update mirrors task periodically."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Run Update mirrors task when Gitea starts."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RUN_AT_START = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Notice if not success"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";NOTICE_ON_SUCCESS = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Limit the number of mirrors added to the queue to this number"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; (negative values mean no limit, 0 will result in no result in no mirrors being queued effectively disabling pull mirror updating.)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PULL_LIMIT=50"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Limit the number of mirrors added to the queue to this number"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; (negative values mean no limit, 0 will result in no mirrors being queued effectively disabling push mirror updating)"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";PUSH_LIMIT=50"
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Repository health check"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";[cron.repo_health_check]"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";SCHEDULE = @midnight"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Enable running Repository health check task periodically."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ENABLED = true"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Run Repository health check task when Gitea starts."
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";RUN_AT_START = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Notice if not success"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";NOTICE_ON_SUCCESS = false"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";TIMEOUT = 60s"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Arguments for command 'git fsck', e.g. \"--unreachable --tags\""
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; see more on http://git-scm.com/docs/git-fsck"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";ARGS ="
      NEWLINE "\n"
    BLANK_LINE
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";; Check repository statistics"
      NEWLINE "\n"
    COMMENT_LINE
      COMMENT ";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;"
